generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String       @id @default(uuid())
  clerkId                 String       @unique
  email                   String       @unique
  name                    String?
  githubInstallationId    String?      @unique
  githubAccessToken       String?
  githubAccessTokenExpiry DateTime?
  githubUsername          String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  repositories            Repository[]
  chatMessages            ChatMessage[]
}

model Repository {
  id                           String    @id @default(uuid())
  repositoryId                 String    // GitHub repository ID
  name                         String
  fullName                     String
  owner                        String
  isSupported                  Boolean   @default(false)
  framework                    String? // "next", "react", or null
  packageJson                  Json? // Store the entire package.json
  defaultBranch                String?
  baseDirectory                String? // Path where package.json was found
  repoContent                  Json? // Directory contents as array
  archetypes                   Json? // [{ name: "ai-powered", score: 0.91 }, ...]
  archClassificationConfidence String? // "high" | "medium" | "low"
  userId                       String
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // graphStatus                  String? // "building", "ready", "failed"
  // graphBuiltAt                 DateTime?
  repoSizeKB                   Int? // GitHub-reported repo size in KB
  compiledReport               String? // Final compiled markdown report from report-compiler agent
  compiledReportAt             DateTime? // When the compiled report was last generated
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  // codeNodes    CodeNode[]
  // codeEdges    CodeEdge[]
  // codeFlows    CodeFlow[]
  agentReports AgentReport[]
  chatMessages ChatMessage[]

  @@index([userId])
  @@index([repositoryId])
  @@unique([userId, repositoryId])
}

model AgentReport {
  id           String     @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  archetype       String // "database-heavy", "auth-heavy", etc.
  rawFindings     String? // The agent's raw text output
  totalToolCalls  Int     @default(0)
  executionTimeMs Int     @default(0)
  status          String  @default("pending") // "pending" | "running" | "completed" | "failed"
  error           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, archetype])
  @@index([repositoryId])
}

model GithubAuthState {
  id        String   @id @default(uuid())
  state     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

