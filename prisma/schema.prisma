generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String       @id @default(uuid())
  clerkId                 String       @unique
  email                   String       @unique
  name                    String?
  githubInstallationId    String?      @unique
  githubAccessToken       String?
  githubAccessTokenExpiry DateTime?
  githubUsername          String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  repositories            Repository[]
}

model Repository {
  id                           String   @id @default(uuid())
  repositoryId                 String   @unique // GitHub repository ID
  name                         String
  fullName                     String
  owner                        String
  isSupported                  Boolean  @default(false)
  framework                    String? // "next", "react", or null
  packageJson                  Json? // Store the entire package.json
  defaultBranch                String?
  baseDirectory                String? // Path where package.json was found
  repoContent                  Json? // Directory contents as array
  archetypes                   Json? // [{ name: "ai-powered", score: 0.91 }, ...]
  archClassificationConfidence String? // "high" | "medium" | "low"
  userId                       String
  user                         User     @relation(fields: [userId], references: [clerkId])
  graphStatus                  String?  // "building", "ready", "failed"
  graphBuiltAt                 DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  codeNodes    CodeNode[]
  codeEdges    CodeEdge[]
  codeFlows    CodeFlow[]

  @@index([userId])
  @@index([repositoryId])
}

model GithubAuthState {
  id        String   @id @default(uuid())
  state     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CodeNode {
  id            String     @id @default(uuid())
  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  kind          String     // "File", "Class", "Function"
  name          String
  qualifiedName String     // "src/routes/users.ts::UserService.getUsers"
  filePath      String
  lineStart     Int?
  lineEnd       Int?
  language      String?    // "javascript", "typescript", "tsx"
  parentName    String?    // enclosing class name
  params        String?
  returnType    String?
  fileHash      String?
  extra         Json       @default("{}")

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([repositoryId, qualifiedName])
  @@index([repositoryId])
  @@index([repositoryId, filePath])
  @@index([repositoryId, kind])
}

model CodeEdge {
  id              String     @id @default(uuid())
  repositoryId    String
  repository      Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  kind            String     // "CALLS", "IMPORTS_FROM", "INHERITS", "CONTAINS"
  sourceQualified String
  targetQualified String
  filePath        String
  line            Int        @default(0)
  extra           Json       @default("{}")

  createdAt       DateTime   @default(now())

  @@index([repositoryId])
  @@index([repositoryId, sourceQualified])
  @@index([repositoryId, targetQualified])
  @@index([repositoryId, kind])
}

model CodeFlow {
  id             String     @id @default(uuid())
  repositoryId   String
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  name           String     // entry point name (e.g. "getUsers")
  entryPointQn   String     // qualified name of entry point
  depth          Int
  nodeCount      Int
  fileCount      Int
  criticality    Float      @default(0.0)  // 0.0 - 1.0 scale-risk score
  pathJson       Json       @default("[]") // ordered qualified names
  filesJson      Json       @default("[]") // distinct files touched

  createdAt      DateTime   @default(now())

  @@index([repositoryId])
  @@index([repositoryId, criticality])
}
