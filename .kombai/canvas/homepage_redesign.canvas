    },
    "var_defff87294e7": {
      "type": "variant",
      "label": "Editorial Terminal - The Laboratory",
      "parentId": "var_bc574f0d21eb",
      "themeId": null,
      "rect": {
        "x": 7381,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #111111;\n    color: #FFFFFF;\n    font-family: 'IBM Plex Sans', sans-serif;\n    overflow: hidden;\n  }\n\n  .font-mono {\n    font-family: 'Inconsolata', monospace;\n  }\n\n  .glass-panel {\n    background: rgba(255, 255, 255, 0.02);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .acid-glow {\n    text-shadow: 0 0 10px rgba(163, 230, 53, 0.4);\n  }\n\n  .grid-bg {\n    background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.05) 1px, transparent 0);\n    background-size: 24px 24px;\n  }\n\n  @keyframes pulse-ring {\n    0% { transform: scale(0.8); opacity: 0.5; }\n    50% { transform: scale(1.2); opacity: 0.2; }\n    100% { transform: scale(0.8); opacity: 0.5; }\n  }\n\n  .animate-pulse-ring {\n    animation: pulse-ring 3s ease-in-out infinite;\n  }\n\n  @utility acid-sweep {\n    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n    &:hover {\n      background-color: #A3E635;\n      color: #111111;\n    }\n  }\n</style>\n<div class=\"h-screen w-full flex flex-col relative grid-bg\" data-kid=\"1\">\n    <!-- Top Navigation -->\n    <nav class=\"h-20 border-b border-white/10 flex items-center justify-between px-12 z-50 glass-panel\" data-kid=\"2\">\n        <div class=\"flex items-center gap-3 md:w-64\" data-kid=\"2-1\">\n            <span class=\"font-mono text-2xl font-black tracking-tighter uppercase\" data-kid=\"2-1-1\">\n                GRO\n                <span class=\"text-[#A3E635]\" data-kid=\"2-1-1-1\">\n                    (W)\n                </span>\n                ISE\n            </span>\n        </div>\n        <div class=\"flex-1 hidden md:flex items-center justify-center gap-12 font-mono text-[11px] uppercase tracking-[0.2em] font-bold text-white/50\" data-kid=\"2-2\">\n            <a class=\"hover:text-[#A3E635] transition-colors\" data-kid=\"2-2-1\" href=\"#\">\n                Home\n            </a>\n            <a class=\"hover:text-[#A3E635] transition-colors\" data-kid=\"2-2-2\" href=\"#\">\n                Dashboard\n            </a>\n            <a class=\"hover:text-[#A3E635] transition-colors\" data-kid=\"2-2-3\" href=\"#\">\n                Pricing\n            </a>\n            <a class=\"hover:text-[#A3E635] transition-colors text-white border-b border-[#A3E635]\" data-kid=\"2-2-4\" href=\"#\">\n                Terminal\n            </a>\n        </div>\n        <div class=\"md:w-64 flex justify-end\" data-kid=\"2-3\">\n            <button class=\"px-8 py-2 border border-white/20 font-mono text-[11px] uppercase tracking-widest acid-sweep\" data-kid=\"2-3-1\">\n                Login\n            </button>\n        </div>\n    </nav>\n    <!-- Main Terminal Interface -->\n    <main class=\"flex-1 flex overflow-hidden p-8 gap-8\" data-kid=\"3\">\n        <!-- Left: Data-Dense Logs -->\n        <div class=\"w-1/3 flex flex-col gap-6\" data-kid=\"3-1\">\n            <div class=\"glass-panel flex-1 flex flex-col p-6 font-mono text-[11px] relative overflow-hidden\" data-kid=\"3-1-1\">\n                <div class=\"flex items-center justify-between mb-6 text-white/30 uppercase tracking-widest border-b border-white/10 pb-4\" data-kid=\"3-1-1-1\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"3-1-1-1-1\">\n                        <i class=\"ti ti-terminal-2 text-lg text-[#A3E635]\" data-kid=\"3-1-1-1-1-1\">\n                        </i>\n                        <span data-kid=\"3-1-1-1-1-2\">\n                            Process_Stream\n                        </span>\n                    </div>\n                    <span class=\"text-[9px]\" data-kid=\"3-1-1-1-2\">\n                        [PID: 0X92A]\n                    </span>\n                </div>\n                <div class=\"space-y-4 flex-1\" data-dynamic=\"true\" data-kid=\"3-1-1-3\" data-name=\"log container list\" data-reason=\"log line elements dynamically injected by script\" id=\"log-container\">\n                    <!-- Log lines will be typed here -->\n                </div>\n                <!-- System Metadata Footer -->\n                <div class=\"mt-auto pt-6 border-t border-white/10 grid grid-cols-2 gap-4 text-[9px] text-white/20 uppercase tracking-tighter\" data-kid=\"3-1-1-2\">\n                    <div class=\"flex flex-col gap-1\" data-kid=\"3-1-1-2-1\">\n                        <span data-kid=\"3-1-1-2-1-1\">\n                            MEM: 124.5MB / 512MB\n                        </span>\n                        <span data-kid=\"3-1-1-2-1-2\">\n                            CPU: 12% AVG\n                        </span>\n                    </div>\n                    <div class=\"flex flex-col gap-1 items-end\" data-kid=\"3-1-1-2-2\">\n                        <span data-kid=\"3-1-1-2-2-1\">\n                            UPTIME: 00:04:12\n                        </span>\n                        <span data-kid=\"3-1-1-2-2-2\">\n                            NODE: v21.4.0\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Right: High-Fidelity Visualization -->\n        <div class=\"flex-1 flex flex-col gap-6\" data-kid=\"3-2\">\n            <div class=\"glass-panel flex-1 relative flex items-center justify-center overflow-hidden\" data-kid=\"3-2-1\">\n                <!-- Visualization Header Overlay -->\n                <div class=\"absolute top-6 left-6 right-6 flex items-center justify-between z-10\" data-kid=\"3-2-1-1\">\n                    <div class=\"flex items-center gap-4 bg-[#111] px-4 py-2 border border-white/10 rounded-full\" data-kid=\"3-2-1-1-1\">\n                        <div class=\"w-2 h-2 rounded-full bg-[#A3E635] animate-pulse\" data-kid=\"3-2-1-1-1-1\">\n                        </div>\n                        <span class=\"font-mono text-[10px] uppercase tracking-widest text-[#A3E635]\" data-dynamic=\"true\" data-kid=\"3-2-1-1-1-2\" data-name=\"active process status label\" data-reason=\"text content updated by script\" id=\"active-status\">\n                            Initializing...\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"3-2-1-1-2\">\n                        <div class=\"px-3 py-1 border border-white/10 bg-white/5 rounded font-mono text-[9px] text-white/40\" data-kid=\"3-2-1-1-2-1\">\n                            BUFFER: 2048KB\n                        </div>\n                    </div>\n                </div>\n                <!-- Diagnostic Content Area -->\n                <div class=\"w-full h-full flex items-center justify-center p-12\" data-dynamic=\"true\" data-kid=\"3-2-1-2\" data-name=\"diagnostic visualization content area\" data-reason=\"visualization HTML replaced by script\" id=\"visualization-content\">\n                    <!-- Visuals injected by script -->\n                </div>\n                <!-- Ambient Decorative Elements -->\n                <div class=\"absolute inset-0 pointer-events-none opacity-20\" data-kid=\"3-2-1-3\">\n                    <div class=\"absolute top-0 right-0 w-64 h-64 bg-[#A3E635]/10 blur-[100px]\" data-kid=\"3-2-1-3-1\">\n                    </div>\n                    <div class=\"absolute bottom-0 left-0 w-64 h-64 bg-blue-500/10 blur-[100px]\" data-kid=\"3-2-1-3-2\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n    <!-- Global Footer Decor -->\n    <div class=\"h-10 px-12 border-t border-white/10 flex items-center justify-between font-mono text-[9px] text-white/20 uppercase tracking-widest glass-panel\" data-kid=\"4\">\n        <span data-kid=\"4-1\">\n            System_Status: Operational\n        </span>\n        <div class=\"flex gap-8\" data-kid=\"4-2\">\n            <span data-kid=\"4-2-1\">\n                Region: US-EAST-1\n            </span>\n            <span data-kid=\"4-2-2\">\n                Lat: 24ms\n            </span>\n        </div>\n    </div>\n</div>\n<script type=\"module\">\n    import { animate, stagger, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  const STEPS = [\n    {\n      id: \"auth\",\n      label: \"AUTH_GITHUB_CONNECT\",\n      status: \"Verified Identity\",\n      visual: `\n        <div class=\"flex flex-col items-center gap-8\">\n          <div class=\"relative\">\n            <div class=\"absolute inset-0 animate-pulse-ring rounded-full bg-[#A3E635]/20\"></div>\n            <img src=\"https://images.unsplash.com/photo-1719603785926-84d214438120?auto=format&w=200&q=80&fit=crop\" class=\"w-32 h-32 rounded-full border-4 border-[#A3E635]/30 relative z-10 grayscale brightness-125\" decoding=\"async\" loading=\"lazy\">\n            <div class=\"absolute -bottom-2 -right-2 w-12 h-12 bg-[#111] border-2 border-[#A3E635] rounded-full flex items-center justify-center z-20\">\n              <i class=\"ti ti-brand-github text-xl text-[#A3E635]\"></i>\n            </div>\n          </div>\n          <div class=\"text-center font-mono\">\n            <h3 class=\"text-xl font-bold tracking-tight mb-2 uppercase\">David_C_Kit</h3>\n            <p class=\"text-white/40 text-[10px] uppercase tracking-widest\">Handshake Complete // Tokens Staged</p>\n          </div>\n        </div>\n      `\n    },\n    {\n      id: \"repo\",\n      label: \"SELECT_REPOSITORY\",\n      status: \"Target Locked\",\n      visual: `\n        <div class=\"w-full max-w-md glass-panel p-8 rounded-xl border-[#A3E635]/20 flex flex-col gap-6\">\n          <div class=\"flex items-center justify-between\">\n            <div class=\"flex items-center gap-4\">\n              <div class=\"w-12 h-12 bg-[#A3E635]/10 border border-[#A3E635]/30 rounded flex items-center justify-center\">\n                <i class=\"ti ti-git-branch text-2xl text-[#A3E635]\"></i>\n              </div>\n              <div>\n                <h4 class=\"font-mono text-lg font-bold tracking-tight\">saas-architecture-v2</h4>\n                <p class=\"font-mono text-[10px] text-white/30 tracking-widest uppercase\">main branch // 2.4gb payload</p>\n              </div>\n            </div>\n            <i class=\"ti ti-circle-check-filled text-[#A3E635] text-xl\"></i>\n          </div>\n          <div class=\"space-y-2 font-mono text-[9px] text-white/20\">\n            <div class=\"flex justify-between\"><span>Last Commit:</span> <span class=\"text-white/40\">#f2a92b</span></div>\n            <div class=\"flex justify-between\"><span>Objects:</span> <span class=\"text-white/40\">14,204</span></div>\n            <div class=\"flex justify-between\"><span>Entropy:</span> <span class=\"text-[#A3E635]\">Stable</span></div>\n          </div>\n        </div>\n      `\n    },\n    {\n      id: \"framework\",\n      label: \"DETECT_FRAMEWORK\",\n      status: \"Next.js 14.2 Detected\",\n      visual: `\n        <div class=\"relative flex flex-col items-center gap-12\">\n          <div class=\"relative w-64 h-64 flex items-center justify-center\">\n            <div class=\"absolute inset-0 border-2 border-dashed border-[#A3E635]/10 rounded-full animate-[spin_20s_linear_infinite]\"></div>\n            <div class=\"absolute inset-4 border border-[#A3E635]/20 rounded-full animate-[spin_10s_linear_infinite_reverse]\"></div>\n            <div class=\"w-48 h-48 glass-panel rounded-full flex items-center justify-center relative\">\n               <i class=\"ti ti-brand-nextjs text-[100px] text-white brightness-200\"></i>\n            </div>\n            <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-[1px] h-full bg-gradient-to-b from-transparent via-[#A3E635] to-transparent animate-pulse\"></div>\n          </div>\n          <div class=\"font-mono text-center\">\n            <div class=\"text-[10px] text-white/30 uppercase tracking-[0.5em] mb-4\">Scanning_Tree</div>\n            <div class=\"px-6 py-2 border border-[#A3E635] bg-[#A3E635]/10 font-bold text-[#A3E635] text-lg tracking-widest\">NEXTJS_14.2</div>\n          </div>\n        </div>\n      `\n    },\n    {\n      id: \"arch\",\n      label: \"MAP_ARCHITECTURE\",\n      status: \"Graph Compiled\",\n      visual: `\n        <div class=\"relative w-full max-w-lg h-96 font-mono\">\n          <svg class=\"absolute inset-0 w-full h-full\">\n            <line x1=\"20%\" y1=\"20%\" x2=\"50%\" y2=\"50%\" stroke=\"rgba(163,230,53,0.3)\" stroke-width=\"1\" />\n            <line x1=\"80%\" y1=\"20%\" x2=\"50%\" y2=\"50%\" stroke=\"rgba(163,230,53,0.3)\" stroke-width=\"1\" />\n            <line x1=\"20%\" y1=\"80%\" x2=\"50%\" y2=\"50%\" stroke=\"rgba(163,230,53,0.3)\" stroke-width=\"1\" />\n            <line x1=\"80%\" y1=\"80%\" x2=\"50%\" y2=\"50%\" stroke=\"rgba(163,230,53,0.3)\" stroke-width=\"1\" />\n          </svg>\n          <div class=\"absolute top-[10%] left-[10%] glass-panel p-4 rounded-lg border-[#A3E635]/20\">\n             <div class=\"text-[10px] font-bold text-[#A3E635]\">API_LAYER</div>\n             <div class=\"text-[8px] text-white/40\">24 Endpoints</div>\n          </div>\n          <div class=\"absolute top-[10%] right-[10%] glass-panel p-4 rounded-lg\">\n             <div class=\"text-[10px] font-bold text-white/60\">AUTH_PROVIDER</div>\n             <div class=\"text-[8px] text-white/20\">OAuth/JWT</div>\n          </div>\n          <div class=\"absolute bottom-[10%] left-[10%] glass-panel p-4 rounded-lg\">\n             <div class=\"text-[10px] font-bold text-white/60\">DATABASE_NODE</div>\n             <div class=\"text-[8px] text-white/20\">PostgreSQL</div>\n          </div>\n          <div class=\"absolute bottom-[10%] right-[10%] glass-panel p-4 rounded-lg\">\n             <div class=\"text-[10px] font-bold text-white/60\">CACHE_EDGE</div>\n             <div class=\"text-[8px] text-white/20\">Redis/Upstash</div>\n          </div>\n          <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 bg-[#A3E635] flex flex-col items-center justify-center rounded-xl shadow-[0_0_40px_rgba(163,230,53,0.3)] border-2 border-white/20\">\n             <i class=\"ti ti-cpu text-3xl text-[#111]\"></i>\n             <span class=\"text-[8px] font-black text-[#111] mt-2\">CORE</span>\n          </div>\n        </div>\n      `\n    }\n  ];\n\n  const logContainer = document.getElementById('log-container');\n  const vizContent = document.getElementById('visualization-content');\n  const statusLabel = document.getElementById('active-status');\n\n  async function typeLine(text, id) {\n    const line = document.createElement('div');\n    line.className = 'flex items-start gap-4 transition-all duration-500 opacity-0 translate-x-[-10px]';\n    line.id = \\`log-\\${id}\\`;\n    line.innerHTML = \\`\n      <span class=\"text-[#A3E635]/40 shrink-0\">[\\${new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' })}]</span>\n      <span class=\"flex-1 text-white/80 whitespace-pre-wrap\">\\${text}</span>\n    \\`;\n    logContainer.appendChild(line);\n    \n    // Animate presence\n    animate(line, { opacity: 1, x: 0 }, { duration: 0.4 });\n    \n    // Scroll logic\n    logContainer.scrollTop = logContainer.scrollHeight;\n  }\n\n  async function runWorkflow() {\n    for (let i = 0; i < STEPS.length; i++) {\n      const step = STEPS[i];\n      \n      // Update UI\n      statusLabel.textContent = \\`Active: \\${step.label}...\\`;\n      \n      // Highlight previous logs\n      if (i > 0) {\n        animate(\\`#log-\\${STEPS[i-1].id}\\`, { opacity: 0.4 }, { duration: 0.5 });\n      }\n\n      await typeLine(\\`> Executing task: \\${step.label}...\\`, step.id);\n      \n      // Fade out old viz\n      if (vizContent.firstChild) {\n        animate(vizContent.firstChild, { opacity: 0, scale: 0.95 }, { duration: 0.3 });\n      }\n\n      // Inject new viz\n      setTimeout(() => {\n        vizContent.innerHTML = step.visual;\n        animate(vizContent.firstChild, { opacity: [0, 1], scale: [0.98, 1] }, { duration: 0.5, ease: \"circOut\" });\n      }, 300);\n\n      await new Promise(r => setTimeout(r, 4000));\n    }\n\n    // Loop after complete\n    setTimeout(() => {\n      logContainer.innerHTML = '';\n      runWorkflow();\n    }, 5000);\n  }\n\n  runWorkflow();\n</script>\n",
      "comments": [],
      "created": "2026-07-21T11:28:04.667066+00:00",
      "modified": "2026-07-21T11:28:34.197399+00:00",
      "id": "var_defff87294e7"
    },
    "var_8690f15e9654": {
      "type": "variant",
      "label": "Editorial Terminal - The Cinema",
      "parentId": "var_bc574f0d21eb",
      "themeId": null,
      "rect": {
        "x": 8921,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #0a0a0a;\n    color: #FFFFFF;\n    font-family: 'IBM Plex Sans', sans-serif;\n    overflow: hidden;\n  }\n\n  .font-mono { font-family: 'Inconsolata', monospace; }\n\n  .hero-glass {\n    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.03) 0%, transparent 100%);\n  }\n\n  .grid-overlay {\n    background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);\n    background-size: 80px 80px;\n  }\n\n  .glow-ring {\n    box-shadow: 0 0 60px rgba(163, 230, 53, 0.15), inset 0 0 40px rgba(163, 230, 53, 0.05);\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-20px); }\n  }\n\n  .animate-float { animation: float 6s ease-in-out infinite; }\n  \n  @utility acid-sweep {\n    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n    &:hover { background-color: #A3E635; color: #111111; }\n  }\n</style>\n<div class=\"h-screen w-full flex flex-col items-center justify-center relative overflow-hidden bg-[#0a0a0a]\" data-kid=\"1\">\n    <!-- Background Layers -->\n    <div class=\"absolute inset-0 grid-overlay opacity-40 pointer-events-none\" data-kid=\"1-1\">\n    </div>\n    <div class=\"absolute inset-0 hero-glass pointer-events-none\" data-kid=\"1-2\">\n    </div>\n    <!-- Subtle Vignette -->\n    <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,#0a0a0a_80%)] pointer-events-none\" data-kid=\"1-3\">\n    </div>\n    <!-- Central High-Impact Visualization -->\n    <div class=\"relative z-10 w-full max-w-4xl h-[600px] flex flex-col items-center justify-center\" data-kid=\"2\">\n        <div class=\"w-full h-full relative flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"2-1\" data-name=\"main content visualization stage\" data-reason=\"content dynamically replaced by cinema script\" id=\"main-stage\">\n            <!-- High-fidelity visuals injected here -->\n        </div>\n        <!-- Floating Minimalist Logs -->\n        <div class=\"absolute bottom-[-40px] left-1/2 -translate-x-1/2 w-full max-w-2xl px-12 py-6 bg-black/40 backdrop-blur-xl border border-white/5 rounded-full flex items-center gap-6\" data-kid=\"3\">\n            <div class=\"flex items-center gap-3 shrink-0\" data-kid=\"3-1\">\n                <div class=\"w-2 h-2 rounded-full bg-[#A3E635] animate-pulse\" data-kid=\"3-1-1\">\n                </div>\n                <span class=\"font-mono text-[10px] text-white/40 uppercase tracking-widest\" data-kid=\"3-1-2\">\n                    Pipeline_Live\n                </span>\n            </div>\n            <div class=\"h-4 w-[1px] bg-white/10 shrink-0\" data-kid=\"3-2\">\n            </div>\n            <div class=\"font-mono text-[11px] text-[#A3E635] tracking-tight truncate flex-1\" data-dynamic=\"true\" data-kid=\"3-3\" data-name=\"ambient log status text\" data-reason=\"text replaced by updateAmbient function\" id=\"ambient-log\">\n                Awaiting input sequence...\n            </div>\n            <div class=\"flex gap-2 shrink-0\" data-kid=\"3-4\">\n                <div class=\"w-8 h-8 rounded-full border border-white/10 flex items-center justify-center\" data-kid=\"3-4-1\">\n                    <i class=\"ti ti-activity-heartbeat text-[10px] text-white/20\" data-kid=\"3-4-1-1\">\n                    </i>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- Cinematic Metadata Corners -->\n    <div class=\"absolute top-12 left-12 font-mono text-[10px] text-white/20 flex flex-col gap-1 uppercase\" data-kid=\"4\">\n        <span data-kid=\"4-1\">\n            [ SCAN_MODE: DEEP_HEURISTICS ]\n        </span>\n        <span data-kid=\"4-2\">\n            [ AUTH_TOKEN: ACTIVE ]\n        </span>\n    </div>\n    <div class=\"absolute top-12 right-12 font-mono text-[10px] text-white/20 flex flex-col gap-1 items-end uppercase\" data-kid=\"5\">\n        <span data-kid=\"5-1\">\n            [ FPS: 60.0 ]\n        </span>\n        <span data-kid=\"5-2\">\n            [ BUFFER_LVL: OPTIMAL ]\n        </span>\n    </div>\n    <div class=\"absolute bottom-12 left-12 font-mono text-[10px] text-white/20 uppercase tracking-[0.2em]\" data-kid=\"6\">\n        Gro(W)ise Intelligence // Terminal Cinema v4.0\n    </div>\n</div>\n<script type=\"module\">\n    import { animate, stagger, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  const STEPS = [\n    {\n      label: \"INITIALIZING_AGENT_SWARM\",\n      visual: `\n        <div class=\"relative flex items-center justify-center animate-float\">\n          <div class=\"absolute inset-0 glow-ring rounded-full scale-150 opacity-20 bg-[#A3E635]/10\"></div>\n          <div class=\"w-80 h-80 relative flex items-center justify-center\">\n            <svg class=\"absolute inset-0 w-full h-full animate-[spin_30s_linear_infinite]\" viewBox=\"0 0 100 100\">\n               <circle cx=\"50\" cy=\"50\" r=\"48\" fill=\"none\" stroke=\"rgba(163,230,53,0.1)\" stroke-width=\"0.5\" stroke-dasharray=\"2 4\" />\n            </svg>\n            <div class=\"w-48 h-48 border border-[#A3E635]/30 rounded-2xl bg-white/[0.02] flex items-center justify-center rotate-45 relative\">\n               <i class=\"ti ti-ai text-[80px] text-[#A3E635] -rotate-45 acid-glow\"></i>\n            </div>\n            <!-- Orbiting Agents -->\n            ${[...Array(6)].map((_, i) => `\n              <div class=\"absolute w-4 h-4 bg-[#A3E635] rounded-sm shadow-[0_0_15px_#A3E635] animate-[spin_${10 + i * 2}s_linear_infinite]\" style=\"transform-origin: 160px center; left: -110px;\"></div>\n            `).join('')}\n          </div>\n        </div>\n      `\n    },\n    {\n      label: \"ARCH_MAPPING_PHASE_04\",\n      visual: `\n        <div class=\"w-full h-full flex flex-col items-center justify-center gap-12\">\n          <div class=\"grid grid-cols-3 gap-16 relative\">\n            <!-- Central Node -->\n            <div class=\"col-start-2 row-start-2 w-32 h-32 bg-[#A3E635] rounded-3xl flex items-center justify-center z-20 shadow-[0_0_50px_rgba(163,230,53,0.4)]\">\n               <i class=\"ti ti-cloud-computing text-4xl text-[#111]\"></i>\n            </div>\n            <!-- Surrounding Nodes -->\n            <div class=\"w-24 h-24 glass-panel rounded-2xl flex flex-col items-center justify-center border-white/20 backdrop-blur-md\">\n               <i class=\"ti ti-database text-2xl text-white/60 mb-2\"></i>\n               <span class=\"text-[9px] font-bold tracking-widest text-white/40\">DB_NODE</span>\n            </div>\n             <div class=\"w-24 h-24 glass-panel rounded-2xl flex flex-col items-center justify-center border-white/20 backdrop-blur-md\">\n               <i class=\"ti ti-shield-lock text-2xl text-white/60 mb-2\"></i>\n               <span class=\"text-[9px] font-bold tracking-widest text-white/40\">AUTH_GATE</span>\n            </div>\n             <div class=\"w-24 h-24 glass-panel rounded-2xl flex flex-col items-center justify-center border-white/20 backdrop-blur-md\">\n               <i class=\"ti ti-api-app text-2xl text-white/60 mb-2\"></i>\n               <span class=\"text-[9px] font-bold tracking-widest text-white/40\">REST_CORE</span>\n            </div>\n            <div class=\"w-24 h-24 glass-panel rounded-2xl flex flex-col items-center justify-center border-white/20 backdrop-blur-md\">\n               <i class=\"ti ti-server-cog text-2xl text-white/60 mb-2\"></i>\n               <span class=\"text-[9px] font-bold tracking-widest text-white/40\">INFRA_STR</span>\n            </div>\n          </div>\n          <div class=\"font-mono text-center\">\n             <h2 class=\"text-3xl font-black italic tracking-tighter uppercase mb-2\">Topology_Stable</h2>\n             <p class=\"text-white/20 text-xs tracking-[0.4em]\">Compiling dependency weights...</p>\n          </div>\n        </div>\n      `\n    },\n    {\n      label: \"GENERATING_FIX_PLAN_V0.1\",\n      visual: `\n        <div class=\"flex flex-col items-center gap-12 max-w-xl text-center\">\n          <div class=\"w-40 h-52 glass-panel border-[#A3E635]/40 rounded-lg relative overflow-hidden animate-float\">\n             <div class=\"h-12 border-b border-white/10 flex items-center px-4 justify-between\">\n                <div class=\"flex gap-1\"><div class=\"w-1.5 h-1.5 rounded-full bg-red-500/50\"></div><div class=\"w-1.5 h-1.5 rounded-full bg-amber-500/50\"></div><div class=\"w-1.5 h-1.5 rounded-full bg-green-500/50\"></div></div>\n                <span class=\"text-[7px] text-white/20\">REPORT.DS</span>\n             </div>\n             <div class=\"p-4 space-y-3\">\n                <div class=\"h-1.5 w-3/4 bg-[#A3E635]/20 rounded-full\"></div>\n                <div class=\"h-1.5 w-full bg-white/5 rounded-full\"></div>\n                <div class=\"h-1.5 w-5/6 bg-white/5 rounded-full\"></div>\n                <div class=\"h-1.5 w-2/3 bg-white/5 rounded-full\"></div>\n                <div class=\"h-12 w-full border border-white/5 bg-white/[0.02] rounded-md flex items-center justify-center\">\n                   <i class=\"ti ti-chart-pie text-xl text-[#A3E635]/40\"></i>\n                </div>\n             </div>\n          </div>\n          <div class=\"font-mono\">\n             <div class=\"text-4xl font-bold tracking-tight mb-4 text-white\">98% Compiled</div>\n             <div class=\"flex gap-2\">\n                <div class=\"px-4 py-1.5 border border-white/10 text-[10px] text-white/40 uppercase tracking-widest\">Export_PDF</div>\n                <div class=\"px-4 py-1.5 border border-[#A3E635] bg-[#A3E635]/10 text-[10px] text-[#A3E635] uppercase tracking-widest font-bold\">Push_Fixes</div>\n             </div>\n          </div>\n        </div>\n      `\n    },\n    {\n      label: \"CHATBOT_INTERFACE_READY\",\n      visual: `\n        <div class=\"w-full max-w-2xl glass-panel border-white/10 rounded-2xl overflow-hidden flex flex-col shadow-2xl animate-float\">\n          <div class=\"p-6 border-b border-white/10 flex items-center justify-between\">\n             <div class=\"flex items-center gap-3\">\n                <div class=\"w-8 h-8 rounded-full bg-[#A3E635] flex items-center justify-center\"><i class=\"ti ti-bot text-[#111]\"></i></div>\n                <span class=\"font-mono text-sm font-bold uppercase tracking-widest\">Architect_AI</span>\n             </div>\n             <div class=\"text-[9px] text-white/20 font-mono tracking-widest\">MODEL: GPT-4O-TURBO</div>\n          </div>\n          <div class=\"p-8 space-y-6\">\n             <div class=\"flex gap-4\">\n                <div class=\"w-6 h-6 rounded-full bg-white/10\"></div>\n                <div class=\"flex-1 bg-white/5 p-4 rounded-2xl rounded-tl-none border border-white/5\">\n                   <p class=\"text-sm text-white/70 leading-relaxed font-mono\">Analysis complete. I detected three critical scaling bottlenecks in your database ingestion pipeline. Should I generate a fix plan?</p>\n                </div>\n             </div>\n             <div class=\"flex flex-row-reverse gap-4\">\n                <div class=\"w-6 h-6 rounded-full bg-[#A3E635]/20 border border-[#A3E635]/40\"></div>\n                <div class=\"bg-[#A3E635]/10 border border-[#A3E635]/20 p-4 rounded-2xl rounded-tr-none\">\n                   <p class=\"text-sm text-[#A3E635] leading-relaxed font-mono\">Yes, open a GitHub issue and detail the required schema changes.</p>\n                </div>\n             </div>\n          </div>\n          <div class=\"p-6 mt-auto bg-black/40 border-t border-white/10\">\n             <div class=\"w-full px-6 py-4 bg-white/5 border border-white/10 rounded-full flex items-center justify-between\">\n                <span class=\"text-sm text-white/20 font-mono italic\">Ask anything about your architecture...</span>\n                <i class=\"ti ti-send text-[#A3E635]\"></i>\n             </div>\n          </div>\n        </div>\n      `\n    }\n  ];\n\n  const mainStage = document.getElementById('main-stage');\n  const ambientLog = document.getElementById('ambient-log');\n\n  async function updateAmbient(text) {\n    await animate(ambientLog, { opacity: 0, y: 5 }, { duration: 0.2 });\n    ambientLog.textContent = \\`> \\${text}\\`;\n    await animate(ambientLog, { opacity: 1, y: 0 }, { duration: 0.3 });\n  }\n\n  async function runCinema() {\n    for (const step of STEPS) {\n      await updateAmbient(step.label);\n      \n      // Clear stage\n      if (mainStage.firstChild) {\n        await animate(mainStage.firstChild, { opacity: 0, scale: 1.1, filter: \"blur(20px)\" }, { duration: 0.8, ease: \"circIn\" });\n      }\n      \n      mainStage.innerHTML = step.visual;\n      \n      // Intro animation\n      animate(mainStage.firstChild, \n        { opacity: [0, 1], scale: [0.9, 1], filter: [\"blur(20px)\", \"blur(0px)\"] }, \n        { duration: 1.2, ease: \"circOut\" }\n      );\n      \n      await new Promise(r => setTimeout(r, 6000));\n    }\n    runCinema();\n  }\n\n  runCinema();\n</script>\n",
      "comments": [],
      "created": "2026-07-21T11:29:21.619759+00:00",
      "modified": "2026-07-21T11:29:26.224546+00:00",
      "id": "var_8690f15e9654"
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}