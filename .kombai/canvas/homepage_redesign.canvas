    "var_311292fe581b": {
      "type": "variant",
      "label": "Glassmorphic Center",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Fira+Sans:wght@400;500&display=swap');\n  \n  .font-heading { font-family: 'Space Grotesk', sans-serif; }\n  .font-body { font-family: 'Fira Sans', sans-serif; }\n\n  @keyframes float-1 {\n    0% { transform: translate(0, 0); }\n    50% { transform: translate(100px, 50px); }\n    100% { transform: translate(0, 0); }\n  }\n\n  @keyframes float-2 {\n    0% { transform: translate(0, 0); }\n    50% { transform: translate(-80px, -40px); }\n    100% { transform: translate(0, 0); }\n  }\n\n  .blob-animate-1 { animation: float-1 20s infinite ease-in-out; }\n  .blob-animate-2 { animation: float-2 25s infinite ease-in-out; }\n\n  .glass-effect {\n    backdrop-filter: blur(40px);\n    -webkit-backdrop-filter: blur(40px);\n    background: rgba(255, 255, 255, 0.03);\n  }\n</style>\n<div class=\"relative min-h-screen w-full flex items-center justify-center bg-[#0B0E14] text-slate-200 overflow-hidden font-body\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Background Grid -->\n    <div class=\"absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:40px_40px]\" data-kid=\"1-1\" data-name=\"background grid container\">\n    </div>\n    <!-- Ambient Blobs -->\n    <div class=\"absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-violet-600/20 rounded-full blur-[120px] blob-animate-1 pointer-events-none\" data-kid=\"1-2\" data-name=\"ambient violet glow blob\">\n    </div>\n    <div class=\"absolute bottom-1/4 right-1/4 w-[600px] h-[600px] bg-blue-600/15 rounded-full blur-[150px] blob-animate-2 pointer-events-none\" data-kid=\"1-3\" data-name=\"ambient blue glow blob\">\n    </div>\n    <!-- Header/Nav -->\n    <header class=\"absolute top-0 left-0 w-full p-10 flex items-center justify-between z-50\" data-kid=\"1-4\" data-name=\"main header bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-4-1\" data-name=\"brand identity container\">\n            <div class=\"w-11 h-11 rounded-2xl bg-gradient-to-br from-violet-500 to-blue-600 flex items-center justify-center shadow-2xl shadow-violet-500/20\" data-kid=\"1-4-1-1\" data-name=\"brand icon background box\">\n                <i class=\"ti ti-terminal text-2xl text-white\" data-kid=\"1-4-1-1-1\" data-name=\"terminal icon\">\n                </i>\n            </div>\n            <span class=\"text-2xl font-bold tracking-tighter text-white font-heading\" data-kid=\"1-4-1-2\" data-name=\"brand name text\">\n                Gro(W)ise\n            </span>\n        </div>\n        <div class=\"hidden md:flex items-center gap-10 text-sm font-medium text-slate-400\" data-kid=\"1-4-2\" data-name=\"navigation link container\">\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-4-2-1\" data-name=\"analysis navigation link\" href=\"#\">\n                Analysis\n            </a>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-4-2-2\" data-name=\"pricing navigation link\" href=\"#\">\n                Pricing\n            </a>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-4-2-3\" data-name=\"documentation navigation link\" href=\"#\">\n                Documentation\n            </a>\n            <button class=\"bg-white/5 border border-white/10 px-6 py-2.5 rounded-2xl hover:bg-white/10 transition-colors text-white\" data-kid=\"1-4-2-4\" data-name=\"sign in button\">\n                Sign In\n            </button>\n        </div>\n    </header>\n    <!-- Central Glass Panel -->\n    <main class=\"relative z-20 w-full max-w-3xl mx-6 opacity-0 transform translate-y-8 scale-95 transition-all duration-1000\" data-kid=\"1-5\" data-name=\"central glass panel section\" id=\"glass-panel\">\n        <div class=\"glass-effect border border-white/10 rounded-[48px] p-12 md:p-20 shadow-[0_0_80px_rgba(0,0,0,0.5)] overflow-hidden\" data-kid=\"1-5-1\" data-name=\"glass panel inner container\">\n            <!-- Inset Highlight -->\n            <div class=\"absolute inset-0 rounded-[48px] border border-white/20 pointer-events-none shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]\" data-kid=\"1-5-1-1\" data-name=\"glass panel highlight border\">\n            </div>\n            <div class=\"relative space-y-12\" data-kid=\"1-5-1-2\" data-name=\"glass panel content wrapper\">\n                <div class=\"space-y-6\" data-kid=\"1-5-1-2-1\" data-name=\"hero text block\">\n                    <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-400 text-xs font-bold uppercase tracking-[0.2em]\" data-kid=\"1-5-1-2-1-1\" data-name=\"system status badge\">\n                        <span class=\"relative flex h-2 w-2\" data-kid=\"1-5-1-2-1-1-1\" data-name=\"status ping indicator\">\n                            <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75\" data-kid=\"1-5-1-2-1-1-1-1\" data-name=\"ping pulse animation circle\">\n                            </span>\n                            <span class=\"relative inline-flex rounded-full h-2 w-2 bg-violet-500\" data-kid=\"1-5-1-2-1-1-1-2\" data-name=\"status active dot\">\n                            </span>\n                        </span>\n                        System Active\n                    </div>\n                    <h1 class=\"text-6xl md:text-8xl font-bold tracking-tight text-white font-heading leading-[1.05]\" data-kid=\"1-5-1-2-1-2\" data-name=\"main hero headline text\">\n                        Analyze\n                        <br data-kid=\"1-5-1-2-1-2-1\" data-name=\"line break element\"/>\n                        <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-violet-400 via-blue-400 to-emerald-400\" data-kid=\"1-5-1-2-1-2-2\" data-name=\"gradient hero headline text\">\n                            business scale.\n                        </span>\n                    </h1>\n                    <p class=\"text-xl md:text-2xl text-slate-400 max-w-xl leading-relaxed\" data-kid=\"1-5-1-2-1-3\" data-name=\"hero description text\">\n                        Intelligent analysis and automated fixes for your business's scalability challenges. Find bottlenecks before they find you.\n                    </p>\n                </div>\n                <!-- GitHub Integration Row -->\n                <div class=\"bg-white/[0.03] border border-white/10 rounded-[32px] p-6 flex flex-col md:flex-row items-center justify-between gap-6 group/row hover:bg-white/[0.06] transition-all duration-300\" data-kid=\"1-5-1-2-2\" data-name=\"github integration section\">\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-5-1-2-2-1\" data-name=\"github connector info\">\n                        <div class=\"w-16 h-16 rounded-2xl bg-slate-950 flex items-center justify-center border border-white/10 shadow-inner group-hover/row:border-white/20 transition-colors\" data-kid=\"1-5-1-2-2-1-1\" data-name=\"github icon background box\">\n                            <i class=\"ti ti-brand-github text-3xl text-white\" data-kid=\"1-5-1-2-2-1-1-1\" data-name=\"github brand icon\">\n                            </i>\n                        </div>\n                        <div class=\"text-center md:text-left\" data-kid=\"1-5-1-2-2-1-2\" data-name=\"github connection status text\">\n                            <div class=\"text-white text-lg font-semibold tracking-tight\" data-kid=\"1-5-1-2-2-1-2-1\" data-name=\"github title text\">\n                                GitHub Connection\n                            </div>\n                            <div class=\"text-slate-500\" data-kid=\"1-5-1-2-2-1-2-2\" data-name=\"github subtitle text\">\n                                Connect repository to start audit\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"w-full md:w-auto px-10 py-4 bg-white text-slate-950 rounded-2xl font-bold text-lg hover:bg-slate-200 transition-all shadow-xl shadow-white/5 active:scale-95\" data-kid=\"1-5-1-2-2-2\" data-name=\"github connect button\" id=\"github-btn\">\n                        Connect Now\n                    </button>\n                </div>\n            </div>\n        </div>\n    </main>\n    <!-- Footer -->\n    <footer class=\"absolute bottom-10 left-0 w-full px-10 flex items-center justify-between text-slate-600 text-[10px] font-bold tracking-[0.3em] uppercase z-10\" data-kid=\"1-6\" data-name=\"footer bar\">\n        <div class=\"flex items-center gap-4\" data-kid=\"1-6-1\" data-name=\"version info container\">\n            <span class=\"w-8 h-[1px] bg-slate-800\" data-kid=\"1-6-1-1\" data-name=\"version divider line\">\n            </span>\n            VERSION 2.4.0\n        </div>\n        <div class=\"flex gap-10\" data-kid=\"1-6-2\" data-name=\"footer navigation link container\">\n            <a class=\"hover:text-slate-300 transition-colors\" data-kid=\"1-6-2-1\" data-name=\"secure link\" href=\"#\">\n                Secure\n            </a>\n            <a class=\"hover:text-slate-300 transition-colors\" data-kid=\"1-6-2-2\" data-name=\"fast link\" href=\"#\">\n                Fast\n            </a>\n            <a class=\"hover:text-slate-300 transition-colors\" data-kid=\"1-6-2-3\" data-name=\"reliable link\" href=\"#\">\n                Reliable\n            </a>\n        </div>\n    </footer>\n</div>\n<link data-kid=\"2\" data-name=\"icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script type=\"module\">\n    import { animate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // Entrance Animation\n  const panel = document.getElementById('glass-panel');\n  animate(panel, \n    { opacity: [0, 1], y: [40, 0], scale: [0.95, 1] }, \n    { duration: 1.2, ease: [0.22, 1, 0.36, 1] }\n  );\n\n  // Button Interaction\n  const btn = document.getElementById('github-btn');\n  btn.addEventListener('mouseenter', () => {\n    animate(btn, { scale: 1.05, boxShadow: \"0 20px 40px rgba(255, 255, 255, 0.1)\" }, { type: \"spring\", stiffness: 400, damping: 12 });\n  });\n  btn.addEventListener('mouseleave', () => {\n    animate(btn, { scale: 1, boxShadow: \"0 10px 20px rgba(255, 255, 255, 0.05)\" }, { type: \"spring\", stiffness: 400, damping: 12 });\n  });\n</script>\n",
