        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=IBM+Plex+Sans:wght@300;400;500;600;700;900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #111111;\n    color: #FFFFFF;\n    font-family: 'IBM Plex Sans', sans-serif;\n    overflow: hidden; /* No scroll as per requirement */\n    height: 100vh;\n    width: 100vw;\n  }\n\n  .font-mono {\n    font-family: 'Inconsolata', monospace;\n  }\n\n  .hairline {\n    border-color: rgba(255, 255, 255, 0.15);\n  }\n\n  .acid-text {\n    color: #A3E635;\n  }\n\n  .acid-bg {\n    background-color: #A3E635;\n  }\n\n  .acid-border {\n    border-color: #A3E635;\n  }\n\n  .scrollbar-hide::-webkit-scrollbar {\n    display: none;\n  }\n\n  .cursor-blink {\n    display: inline-block;\n    width: 0.6em;\n    height: 1.1em;\n    background-color: #A3E635;\n    vertical-align: middle;\n    margin-left: 4px;\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  /* Scramble effect target */\n  .scramble-char {\n    display: inline-block;\n    min-width: 0.5em;\n  }\n\n  /* Isometric container */\n  .isometric-view {\n    perspective: 1000px;\n  }\n  .isometric-element {\n    transform: rotateX(45deg) rotateZ(-45deg);\n  }\n</style>\n<div class=\"flex h-screen w-full overflow-hidden bg-[#111111] selection:bg-[#A3E635] selection:text-[#111111]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- LEFT COLUMN (15%) -->\n    <aside class=\"w-[15%] border-r border-white/15 flex flex-col justify-between py-12 items-center relative z-20\" data-kid=\"1-1\" data-name=\"left sidebar navigation\">\n        <!-- Logo: GRO (W) ISE vertically stacked -->\n        <div class=\"font-mono text-xl font-black tracking-tighter flex flex-col items-center gap-0.5 leading-none opacity-80\" data-kid=\"1-1-1\" data-name=\"logo container\" id=\"logo\">\n            <span data-kid=\"1-1-1-1\" data-name=\"letter G\">\n                G\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"letter R\">\n                R\n            </span>\n            <span data-kid=\"1-1-1-3\" data-name=\"letter O\">\n                O\n            </span>\n            <div class=\"acid-text my-2 relative\" data-kid=\"1-1-1-4\" data-name=\"logo W bracket container\">\n                <span class=\"relative z-10\" data-kid=\"1-1-1-4-1\" data-name=\"bracketed text\">\n                    (W)\n                </span>\n                <div class=\"absolute -inset-1 acid-bg/10 blur-sm rounded-full\" data-kid=\"1-1-1-4-2\" data-name=\"logo glow effect\">\n                </div>\n            </div>\n            <span data-kid=\"1-1-1-5\" data-name=\"letter I\">\n                I\n            </span>\n            <span data-kid=\"1-1-1-6\" data-name=\"letter S\">\n                S\n            </span>\n            <span data-kid=\"1-1-1-7\" data-name=\"letter E\">\n                E\n            </span>\n        </div>\n        <!-- Navigation: Rotated -90 degrees -->\n        <nav class=\"flex flex-col gap-36 items-center flex-1 justify-center relative\" data-kid=\"1-1-2\" data-name=\"vertical navigation links\">\n            <a class=\"rotate-[-90deg] whitespace-nowrap text-[10px] font-mono uppercase tracking-[0.4em] text-white/40 hover:text-[#A3E635] nav-link transition-colors duration-200\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#\">\n                Dashboard\n            </a>\n            <a class=\"rotate-[-90deg] whitespace-nowrap text-[10px] font-mono uppercase tracking-[0.4em] text-white/40 hover:text-[#A3E635] nav-link transition-colors duration-200\" data-kid=\"1-1-2-2\" data-name=\"infra nodes navigation link\" href=\"#\">\n                Infra_Nodes\n            </a>\n            <a class=\"rotate-[-90deg] whitespace-nowrap text-[10px] font-mono uppercase tracking-[0.4em] text-white/40 hover:text-[#A3E635] nav-link transition-colors duration-200\" data-kid=\"1-1-2-3\" data-name=\"security api navigation link\" href=\"#\">\n                Security_API\n            </a>\n        </nav>\n        <!-- Status indicator -->\n        <div class=\"flex items-center gap-2 font-mono text-[9px] acid-text tracking-widest uppercase\" data-kid=\"1-1-3\" data-name=\"system status indicator\">\n            <span class=\"w-1.5 h-1.5 rounded-full acid-bg animate-pulse\" data-kid=\"1-1-3-1\" data-name=\"pulsing status light\">\n            </span>\n            [SYS_OK]\n        </div>\n    </aside>\n    <!-- CENTER COLUMN (60%) -->\n    <main class=\"w-[60%] border-r border-white/15 flex flex-col z-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Top Half: Massive Headline with Scramble Effect -->\n        <section class=\"h-1/2 p-16 flex items-center justify-center border-b border-white/15 relative overflow-hidden bg-black/5\" data-kid=\"1-2-1\" data-name=\"hero headline section\">\n            <div class=\"absolute inset-0 pointer-events-none opacity-5\" data-kid=\"1-2-1-1\" data-name=\"radial grid background\" style=\"background-image: radial-gradient(#A3E635 1px, transparent 1px); background-size: 30px 30px;\">\n            </div>\n            <h1 class=\"text-[7.5vw] font-black uppercase leading-[0.82] tracking-tighter text-center cursor-default\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"scramble headline text\" data-reason=\"text scrambled and replaced by JS script on hover\" id=\"headline\">\n                Scale\n                <br data-kid=\"1-2-1-2-1\" data-name=\"line break\"/>\n                Without\n                <br data-kid=\"1-2-1-2-2\" data-name=\"line break\"/>\n                Breaking.\n            </h1>\n            <!-- Tiny Meta -->\n            <div class=\"absolute top-6 left-8 text-white/10 font-mono text-[9px] uppercase tracking-[0.2em]\" data-kid=\"1-2-1-3\" data-name=\"meta info text\">\n                Interface // Terminal_Alpha_4.0\n            </div>\n        </section>\n        <!-- Bottom Half: Expanded Terminal Log -->\n        <section class=\"h-1/2 p-12 font-mono text-xs overflow-hidden flex flex-col bg-black/20 relative\" data-kid=\"1-2-2\" data-name=\"terminal log section\">\n            <!-- Scanline effect overlay -->\n            <div class=\"absolute inset-0 pointer-events-none opacity-[0.03] z-50 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]\" data-kid=\"1-2-2-1\" data-name=\"scanline effect overlay\">\n            </div>\n            <div class=\"flex items-center justify-between mb-8 text-white/20 uppercase tracking-[0.3em] border-b border-white/5 pb-4\" data-kid=\"1-2-2-2\" data-name=\"terminal header bar\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-1\" data-name=\"terminal icon container\">\n                    <i class=\"ti ti-terminal-2 acid-text text-lg\" data-kid=\"1-2-2-2-1-1\" data-name=\"terminal icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-1-2\" data-name=\"terminal title text\">\n                        Execution_Log_Main\n                    </span>\n                </div>\n                <div class=\"flex gap-4 items-center\" data-kid=\"1-2-2-2-2\" data-name=\"terminal info group\">\n                    <span class=\"text-[9px]\" data-kid=\"1-2-2-2-2-1\" data-name=\"terminal session id text\">\n                        ID: 0x2294A\n                    </span>\n                    <span class=\"text-[9px]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2\" data-name=\"system clock display\" data-reason=\"text replaced every second by time script\" id=\"current-time\">\n                        UTC 00:00:00\n                    </span>\n                </div>\n            </div>\n            <div class=\"space-y-4 overflow-y-auto pr-4 scrollbar-hide flex-1\" data-dynamic=\"true\" data-kid=\"1-2-2-3\" data-name=\"terminal scrollable content area\" data-reason=\"content dynamically injected by log script\" id=\"terminal-content\">\n                <!-- JS will inject lines here -->\n            </div>\n            <!-- Input line -->\n            <div class=\"mt-4 pt-4 border-t border-white/5 flex items-center gap-3 font-mono text-[11px]\" data-kid=\"1-2-2-4\" data-name=\"input line area\">\n                <span class=\"acid-text opacity-70\" data-kid=\"1-2-2-4-1\" data-name=\"input prompt text\">\n                    root@gro-wise:~$\n                </span>\n                <span class=\"text-white/80\" data-kid=\"1-2-2-4-2\" data-name=\"awaiting status text\">\n                    awaiting_command_entry...\n                </span>\n                <span class=\"cursor-blink\" data-kid=\"1-2-2-4-3\" data-name=\"blinking cursor\">\n                </span>\n            </div>\n        </section>\n    </main>\n    <!-- RIGHT COLUMN (25%) -->\n    <aside class=\"w-[25%] flex flex-col z-0\" data-kid=\"1-3\" data-name=\"right sidebar panel\">\n        <!-- Top Pane: Syntax Highlighted DB Snippet -->\n        <section class=\"h-1/2 p-8 border-b border-white/15 flex flex-col bg-black/30\" data-kid=\"1-3-1\" data-name=\"syntax highlighted code panel\">\n            <div class=\"mb-6 flex justify-between items-start\" data-kid=\"1-3-1-1\" data-name=\"code header container\">\n                <div class=\"space-y-1\" data-kid=\"1-3-1-1-1\" data-name=\"code file info container\">\n                    <div class=\"text-white/30 text-[9px] uppercase font-mono tracking-widest\" data-kid=\"1-3-1-1-1-1\" data-name=\"filename text\">\n                        fragment://db_link.ts\n                    </div>\n                    <div class=\"text-[10px] font-mono acid-text/50\" data-kid=\"1-3-1-1-1-2\" data-name=\"read-only badge text\">\n                        READ_ONLY_MODE\n                    </div>\n                </div>\n                <i class=\"ti ti-cpu text-2xl acid-text opacity-80\" data-kid=\"1-3-1-1-2\" data-name=\"cpu icon\">\n                </i>\n            </div>\n            <div class=\"relative group flex-1\" data-kid=\"1-3-1-2\" data-name=\"code snippet container\" id=\"code-snippet-container\">\n                <pre class=\"font-mono text-[10px] leading-relaxed text-white/50 bg-[#151515] p-5 border border-white/5 rounded-xs overflow-hidden relative\" data-kid=\"1-3-1-2-1\" data-name=\"code pre block\">\n<span class=\"acid-text\" data-kid=\"1-3-1-2-1-1\" data-name=\"import keyword\">import</span> { Pool } <span class=\"acid-text\" data-kid=\"1-3-1-2-1-2\" data-name=\"from keyword\">from</span> <span class=\"text-white/80\" data-kid=\"1-3-1-2-1-3\" data-name=\"module path string\">'pg'</span>;\n\n<span class=\"text-white/30\" data-kid=\"1-3-1-2-1-4\" data-name=\"comment text\">// init elastic hook</span>\n<span class=\"acid-text\" data-kid=\"1-3-1-2-1-5\" data-name=\"const keyword\">const</span> db = <span class=\"acid-text\" data-kid=\"1-3-1-2-1-6\" data-name=\"new keyword\">new</span> Pool({\n  host: <span class=\"text-white/80\" data-kid=\"1-3-1-2-1-7\" data-name=\"db host string\">'shrd-v2.net'</span>,\n  db: <span class=\"text-white/80\" data-kid=\"1-3-1-2-1-8\" data-name=\"db name string\">'gw_prod_01'</span>,\n  ssl: <span class=\"acid-text\" data-kid=\"1-3-1-2-1-9\" data-name=\"ssl boolean\">true</span>\n});\n\n<span class=\"acid-text\" data-kid=\"1-3-1-2-1-10\" data-name=\"function keyword\">export async function</span> <span class=\"text-white\" data-kid=\"1-3-1-2-1-11\" data-name=\"sync function name\">sync</span>() {\n  <span class=\"acid-text\" data-kid=\"1-3-1-2-1-12\" data-name=\"const keyword\">const</span> res = <span class=\"acid-text\" data-kid=\"1-3-1-2-1-13\" data-name=\"await keyword\">await</span> db.connect();\n  <span class=\"acid-text\" data-kid=\"1-3-1-2-1-14\" data-name=\"return keyword\">return</span> res.pipe(scalability);\n}\n        </pre>\n                <!-- Decorative frame: aligned tightly -->\n                <div class=\"absolute top-0 left-0 w-2 h-2 border-t border-l border-[#A3E635] z-10 pointer-events-none\" data-kid=\"1-3-1-2-2\" data-name=\"top-left frame corner\">\n                </div>\n                <div class=\"absolute bottom-0 right-0 w-2 h-2 border-b border-r border-[#A3E635] z-10 pointer-events-none\" data-kid=\"1-3-1-2-3\" data-name=\"bottom-right frame corner\">\n                </div>\n            </div>\n        </section>\n        <!-- Bottom Pane: Isometric Server Wireframe -->\n        <section class=\"h-1/2 p-8 flex flex-col relative overflow-hidden group bg-black/10\" data-kid=\"1-3-2\" data-name=\"isometric server section\">\n            <div class=\"absolute top-6 right-6 text-white/10 text-[9px] font-mono text-right z-10\" data-kid=\"1-3-2-1\" data-name=\"architecture scan meta text\">\n                [ARCH_SCAN_009]\n                <br data-kid=\"1-3-2-1-1\" data-name=\"line break\"/>\n                NODE_DENSITY: HIGH\n            </div>\n            <!-- Isometric Visualization -->\n            <div class=\"flex-1 flex flex-col items-center justify-center relative\" data-kid=\"1-3-2-2\" data-name=\"isometric visualization container\">\n                <!-- Technical Crosshair -->\n                <div class=\"absolute inset-0 opacity-10 pointer-events-none\" data-kid=\"1-3-2-2-1\" data-name=\"technical crosshair overlay\">\n                    <div class=\"absolute top-1/2 left-0 w-full h-[1px] bg-white\" data-kid=\"1-3-2-2-1-1\" data-name=\"horizontal line\">\n                    </div>\n                    <div class=\"absolute top-0 left-1/2 w-[1px] h-full bg-white\" data-kid=\"1-3-2-2-1-2\" data-name=\"vertical line\">\n                    </div>\n                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 border border-white rounded-full\" data-kid=\"1-3-2-2-1-3\" data-name=\"circular crosshair\">\n                    </div>\n                </div>\n                <div class=\"relative isometric-view transform-gpu transition-transform duration-1000 group-hover:scale-110\" data-kid=\"1-3-2-2-2\" data-name=\"isometric element wrapper\">\n                    <!-- Multi-layered isometric rack using icon -->\n                    <div class=\"isometric-element relative w-44 h-44\" data-kid=\"1-3-2-2-2-1\" data-name=\"isometric object container\">\n                        <!-- Wireframe Layers: Cleaner filtering -->\n                        <img class=\"absolute inset-0 w-full h-full opacity-20 filter\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"server rack graphic\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/server-rack.svg\" style=\"filter: brightness(0) invert(0.6) sepia(1) saturate(5) hue-rotate(45deg);\"/>\n                        <div class=\"absolute inset-0 border border-[#A3E635]/20 rounded-sm translate-z-10\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"rack border layer 1\">\n                        </div>\n                        <div class=\"absolute inset-0 border border-[#A3E635]/10 rounded-sm translate-z-20\" data-kid=\"1-3-2-2-2-1-3\" data-name=\"rack border layer 2\">\n                        </div>\n                        <!-- Scanning Line -->\n                        <div class=\"absolute top-0 left-0 w-full h-[1px] acid-bg shadow-[0_0_20px_#A3E635] animate-[scan_3s_ease-in-out_infinite]\" data-kid=\"1-3-2-2-2-1-4\" data-name=\"scanning line element\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Detail tags -->\n            <div class=\"mt-auto flex justify-between items-center text-[9px] font-mono text-white/30 uppercase tracking-widest\" data-kid=\"1-3-2-3\" data-name=\"detail tags footer\">\n                <span data-kid=\"1-3-2-3-1\" data-name=\"model tag text\">\n                    V_MODEL_09\n                </span>\n                <div class=\"flex gap-2\" data-kid=\"1-3-2-3-2\" data-name=\"mesh status container\">\n                    <i class=\"ti ti-frame text-xs\" data-kid=\"1-3-2-3-2-1\" data-name=\"frame icon\">\n                    </i>\n                    <span data-kid=\"1-3-2-3-2-2\" data-name=\"status label text\">\n                        MESH_ACTIVE\n                    </span>\n                </div>\n            </div>\n        </section>\n    </aside>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script type=\"module\">\n    // --- INITIAL ANIMATIONS ---\n  function initPage() {\n    gsap.from(\"#logo span\", {\n      opacity: 0,\n      y: -20,\n      duration: 0.5,\n      stagger: 0.05,\n      ease: \"power2.out\"\n    });\n\n    gsap.from(\".nav-link\", {\n      opacity: 0,\n      x: -30,\n      duration: 0.8,\n      stagger: 0.1,\n      ease: \"power2.out\",\n      delay: 0.3\n    });\n\n    gsap.from(\"#headline\", {\n      opacity: 0,\n      scale: 0.9,\n      duration: 1.5,\n      ease: \"expo.out\"\n    });\n  }\n\n  // --- SCRAMBLE EFFECT ---\n  const headline = document.getElementById('headline');\n  const originalText = headline.innerHTML;\n  const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+\";\n\n  function scrambleText(element, finalHtml) {\n    const textNodes = [];\n    // Extract text without losing <br>\n    const temp = document.createElement('div');\n    temp.innerHTML = finalHtml;\n    const items = Array.from(temp.childNodes);\n\n    let progress = 0;\n    const duration = 20; // frames\n    \n    const interval = setInterval(() => {\n      element.innerHTML = items.map(node => {\n        if (node.nodeType === 3) { // Text node\n          return node.textContent.split('').map((char, i) => {\n            if (char === ' ') return ' ';\n            if (Math.random() > progress / duration) {\n              return chars[Math.floor(Math.random() * chars.length)];\n            }\n            return char;\n          }).join('');\n        }\n        return node.outerHTML; // <br>\n      }).join('');\n\n      progress++;\n      if (progress > duration) {\n        clearInterval(interval);\n        element.innerHTML = finalHtml;\n      }\n    }, 40);\n  }\n\n  headline.addEventListener('mouseenter', () => scrambleText(headline, originalText));\n\n  // --- TERMINAL LOGIC ---\n  const terminalContent = document.getElementById('terminal-content');\n  const logs = [\n    { time: \"00.01\", text: \"Initializing kernel modules [0x8823]...\", color: \"white/70\" },\n    { time: \"00.04\", text: \"Fetching infrastructure manifests from srv-edge-01...\", color: \"white/70\" },\n    { time: \"00.08\", text: \"Node balance status: CRITICAL // LOAD_AVG > 4.2\", color: \"acid-text\" },\n    { time: \"00.12\", text: \"Launching recovery protocols (RSA_4096)...\", color: \"white/70\" },\n    { time: \"00.15\", text: \"Re-routing traffic: 10.0.0.1 -> 172.16.2.4\", color: \"white/70\" },\n    { time: \"00.20\", type: \"progress\", label: \"Allocating_Memory_Cluster_A\", progress: 82 },\n    { time: \"00.25\", text: \"Connection established: 200 OK via Cluster_Delta\", color: \"acid-text\" },\n    { time: \"00.30\", type: \"progress\", label: \"Syncing_Database_Replica\", progress: 45 },\n    { time: \"00.35\", text: \"Awaiting final hand-shake: 0xFD22...\", color: \"white/40\" },\n    { time: \"00.38\", text: \"Verifying checksums: [OK] [OK] [OK]\", color: \"white/60\" },\n    { time: \"00.40\", text: \">> SECURITY_LEVEL_HIGH // PROTOCOL_READY\", color: \"acid-text font-black\" }\n  ];\n\n  async function addLogLine(log) {\n    const line = document.createElement('div');\n    line.className = 'flex gap-4';\n    \n    const timeSpan = document.createElement('span');\n    timeSpan.className = 'text-white/20';\n    timeSpan.textContent = `[${log.time}]`;\n    line.appendChild(timeSpan);\n\n    if (log.type === 'progress') {\n      const container = document.createElement('div');\n      container.className = 'flex-1 font-mono';\n      \n      const barsCount = 20;\n      const filledCount = Math.floor((log.progress / 100) * barsCount);\n      const barString = '[' + '|'.repeat(filledCount) + ' '.repeat(barsCount - filledCount) + ']';\n      \n      container.innerHTML = `\n        <div class=\"flex justify-between items-center text-[10px] mb-1\">\n          <span class=\"text-white/60\">${log.label}</span>\n          <span class=\"acid-text\">${log.progress}%</span>\n        </div>\n        <div class=\"text-white/40 leading-none\">${barString}</div>\n      `;\n      line.appendChild(container);\n    } else {\n      const textSpan = document.createElement('span');\n      textSpan.className = `text-${log.color}`;\n      textSpan.textContent = log.text;\n      line.appendChild(textSpan);\n    }\n\n    terminalContent.appendChild(line);\n    terminalContent.scrollTop = terminalContent.scrollHeight;\n  }\n\n  async function runLogs() {\n    for (const log of logs) {\n      await new Promise(r => setTimeout(r, 600 + Math.random() * 800));\n      addLogLine(log);\n    }\n  }\n\n  // --- HELPERS ---\n  function updateTime() {\n    const now = new Date();\n    document.getElementById('current-time').textContent = `UTC ${now.toISOString().slice(11, 19)}`;\n  }\n\n  // START\n  initPage();\n  runLogs();\n  setInterval(updateTime, 1000);\n  updateTime();\n</script>\n<style>\n    @keyframes scan {\n    0% { top: 0%; opacity: 0; }\n    10% { opacity: 1; }\n    90% { opacity: 1; }\n    100% { top: 100%; opacity: 0; }\n  }\n\n  .translate-z-10 { transform: translateZ(-10px); }\n  .translate-z-20 { transform: translateZ(-20px); }\n</style>\n",
      "comments": [],
      "created": "2026-07-20T19:18:59.769321+00:00",
      "modified": "2026-07-20T19:18:59.769321+00:00",
      "id": "var_e10aca9eb730"
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}