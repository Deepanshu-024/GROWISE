    "var_bc574f0d21eb": {
      "type": "variant",
      "label": "Editorial Terminal",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1281,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #111111;\n    color: #FFFFFF;\n    font-family: 'IBM Plex Sans', sans-serif;\n    overflow: hidden;\n  }\n\n  .font-mono {\n    font-family: 'Inconsolata', monospace;\n  }\n\n  .hairline {\n    border-color: rgba(255, 255, 255, 0.15);\n  }\n\n  @utility acid-sweep {\n    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n    &:hover {\n      background-color: #A3E635;\n      color: #111111;\n    }\n  }\n\n  .cursor-blink {\n    display: inline-block;\n    width: 0.6em;\n    height: 1.2em;\n    background-color: #A3E635;\n    vertical-align: middle;\n    margin-left: 4px;\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n</style>\n<div class=\"h-screen w-full flex flex-col relative\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Grid Lines Overlay (Animated via Motion) -->\n    <div class=\"absolute inset-0 pointer-events-none z-10\" data-kid=\"1-1\" data-name=\"grid lines overlay\">\n        <!-- Horizontal Divider -->\n        <div class=\"absolute top-[60vh] left-0 w-full h-[1px] bg-white/15 origin-left\" data-kid=\"1-1-1\" data-name=\"horizontal divider line\" id=\"h-line\">\n        </div>\n        <!-- Vertical Divider -->\n        <div class=\"absolute top-0 left-1/2 w-[1px] h-[60vh] bg-white/15 origin-top\" data-kid=\"1-1-2\" data-name=\"vertical divider line\" id=\"v-line\">\n        </div>\n        <!-- Top Border -->\n        <div class=\"absolute top-16 left-0 w-full h-[1px] bg-white/15 origin-left\" data-kid=\"1-1-3\" data-name=\"top border line\" id=\"t-line\">\n        </div>\n    </div>\n    <!-- Navigation -->\n    <nav class=\"h-16 flex items-center justify-between px-8 z-20\" data-kid=\"1-2\" data-name=\"main navigation bar\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-2-1\" data-name=\"logo container\">\n            <span class=\"font-mono text-xl font-bold tracking-tighter\" data-kid=\"1-2-1-1\" data-name=\"logo text\">\n                GRO\n                <span class=\"text-[#A3E635]\" data-kid=\"1-2-1-1-1\" data-name=\"logo parenthesis\">\n                    (W)\n                </span>\n                ISE\n            </span>\n        </div>\n        <div class=\"flex items-center gap-8 text-xs font-mono uppercase tracking-widest text-white/50\" data-kid=\"1-2-2\" data-name=\"navigation link group\">\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-2-2-1\" data-name=\"dashboard navigation link\" href=\"#\">\n                Dashboard\n            </a>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-2-2-2\" data-name=\"pricing navigation link\" href=\"#\">\n                Pricing\n            </a>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-2-2-3\" data-name=\"docs navigation link\" href=\"#\">\n                Docs\n            </a>\n            <button class=\"px-4 py-1.5 border border-white/20 acid-sweep\" data-kid=\"1-2-2-4\" data-name=\"login action button\">\n                Login\n            </button>\n        </div>\n    </nav>\n    <!-- Main Grid Content -->\n    <main class=\"flex-1 grid grid-cols-2 grid-rows-[60vh_auto]\" data-kid=\"1-3\" data-name=\"main grid content container\">\n        <!-- Top Left: Headline -->\n        <section class=\"p-12 flex flex-col justify-end relative overflow-hidden\" data-kid=\"1-3-1\" data-name=\"headline section\">\n            <div data-kid=\"1-3-1-1\" data-name=\"headline content wrapper\" id=\"headline-container\">\n                <h1 class=\"font-mono text-[8vw] leading-[0.9] font-black tracking-tighter uppercase mb-6 opacity-0\" data-kid=\"1-3-1-1-1\" data-name=\"main headline text\" id=\"main-headline\">\n                    Scale\n                    <br data-kid=\"1-3-1-1-1-1\" data-name=\"line break one\"/>\n                    Without\n                    <br data-kid=\"1-3-1-1-1-2\" data-name=\"line break two\"/>\n                    Breaking.\n                </h1>\n                <p class=\"max-w-md text-white/60 text-sm leading-relaxed opacity-0\" data-kid=\"1-3-1-1-2\" data-name=\"subheadline text\" id=\"subheadline\">\n                    Intelligent analysis and automated fixes for your business's scalability challenges. Find your bottlenecks before they find you.\n                </p>\n            </div>\n        </section>\n        <!-- Top Right: Terminal Log -->\n        <section class=\"p-12 flex flex-col font-mono text-xs leading-relaxed overflow-hidden\" data-kid=\"1-3-2\" data-name=\"terminal log section\">\n            <div class=\"mb-4 text-white/30 uppercase tracking-widest flex items-center gap-2\" data-kid=\"1-3-2-1\" data-name=\"system log header\">\n                <i class=\"ti ti-command text-sm\" data-kid=\"1-3-2-1-1\" data-name=\"command icon\">\n                </i>\n                <span data-kid=\"1-3-2-1-2\" data-name=\"system log title\">\n                    System Log\n                </span>\n            </div>\n            <div class=\"space-y-2\" data-dynamic=\"true\" data-kid=\"1-3-2-2\" data-name=\"terminal log output container\" data-reason=\"log lines injected into element by script\" id=\"terminal-log\">\n                <!-- Lines will be injected by JS -->\n            </div>\n        </section>\n        <!-- Bottom Row: GitHub Connection -->\n        <section class=\"col-span-2 p-12 flex flex-col items-center justify-center relative acid-sweep group cursor-pointer border-t border-white/15\" data-kid=\"1-3-3\" data-name=\"github connection section\" id=\"github-section\">\n            <div class=\"flex flex-col items-center gap-6 z-20\" data-kid=\"1-3-3-1\" data-name=\"connection prompt content\">\n                <div class=\"flex items-center gap-4 font-mono text-2xl font-bold tracking-tight\" data-kid=\"1-3-3-1-1\" data-name=\"connection command wrapper\">\n                    <span class=\"text-white/40 group-hover:text-[#111111]/40 transition-colors\" data-kid=\"1-3-3-1-1-1\" data-name=\"command prefix\">\n                        $\n                    </span>\n                    <span data-kid=\"1-3-3-1-1-2\" data-name=\"connection command text\">\n                        CONNECT_GITHUB_REPOSITORY\n                    </span>\n                    <span class=\"cursor-blink\" data-kid=\"1-3-3-1-1-3\" data-name=\"blinking cursor\">\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-8 opacity-0 transition-all duration-700 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0\" data-kid=\"1-3-3-1-2\" data-name=\"connection steps group\">\n                    <div class=\"flex items-center gap-2 text-xs uppercase tracking-widest\" data-kid=\"1-3-3-1-2-1\" data-name=\"select repository step\">\n                        <i class=\"ti ti-brand-github text-xl\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"github logo icon\">\n                        </i>\n                        <span data-kid=\"1-3-3-1-2-1-2\" data-name=\"select repository text\">\n                            Select Repository\n                        </span>\n                    </div>\n                    <div class=\"h-px w-12 bg-current/20\" data-kid=\"1-3-3-1-2-2\" data-name=\"connector line\">\n                    </div>\n                    <div class=\"flex items-center gap-2 text-xs uppercase tracking-widest\" data-kid=\"1-3-3-1-2-3\" data-name=\"analyze scale step\">\n                        <i class=\"ti ti-circle-check text-xl\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"checkmark icon\">\n                        </i>\n                        <span data-kid=\"1-3-3-1-2-3-2\" data-name=\"analyze scale text\">\n                            Analyze Scale\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Crosshair Ornaments -->\n            <div class=\"absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 z-30 bg-[#111111] px-2 py-1 border border-white/15 group-hover:bg-[#A3E635] group-hover:border-[#111111]/20 transition-colors\" data-kid=\"1-3-3-2\" data-name=\"crosshair ornament\">\n                <i class=\"ti ti-plus text-[10px]\" data-kid=\"1-3-3-2-1\" data-name=\"plus icon\">\n                </i>\n            </div>\n        </section>\n    </main>\n    <!-- Viewport Ornaments -->\n    <div class=\"absolute bottom-8 right-8 font-mono text-[10px] text-white/20 uppercase tracking-widest z-30\" data-kid=\"1-4\" data-name=\"footer version info text\">\n        v1.0.4 // Carbon-Acid Interface\n    </div>\n</div>\n<script type=\"module\">\n    import { animate, stagger, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  const logLines = [\n    \"> Initialize scalabilty_engine_v2.0\",\n    \"> Authenticating agent protocols...\",\n    \"> Scanning codebase for revenue threats...\",\n    \"> Detected 3 potential database bottlenecks\",\n    \"> Analyzing architectural weaknesses...\",\n    \"> Awaiting GitHub repository hook...\"\n  ];\n\n  async function init() {\n    // 1. Draw Grid Lines\n    animate(\"#h-line\", { scaleX: [0, 1] }, { duration: 0.8, ease: \"circOut\" });\n    animate(\"#v-line\", { scaleY: [0, 1] }, { duration: 0.8, ease: \"circOut\", delay: 0.2 });\n    animate(\"#t-line\", { scaleX: [0, 1] }, { duration: 0.6, ease: \"circOut\" });\n\n    // 2. Reveal Headline\n    animate(\"#main-headline\", { opacity: 1, y: [40, 0] }, { duration: 0.8, ease: \"circOut\", delay: 0.4 });\n    animate(\"#subheadline\", { opacity: 1, y: [20, 0] }, { duration: 0.8, ease: \"circOut\", delay: 0.6 });\n\n    // 3. Typewriter Log\n    const logContainer = document.getElementById('terminal-log');\n    for (let i = 0; i < logLines.length; i++) {\n      const line = document.createElement('div');\n      line.className = 'text-white/70';\n      logContainer.appendChild(line);\n      \n      const text = logLines[i];\n      let current = '';\n      for (let char of text) {\n        current += char;\n        line.textContent = current;\n        await new Promise(r => setTimeout(r, 20));\n      }\n      await new Promise(r => setTimeout(r, 100));\n    }\n  }\n\n  init();\n\n  // Interaction for GitHub Section\n  const githubSection = document.getElementById('github-section');\n  githubSection.addEventListener('click', () => {\n    animate(githubSection, { scale: [1, 0.98, 1] }, { duration: 0.2 });\n    console.log('GitHub connection triggered');\n  });\n</script>\n",
