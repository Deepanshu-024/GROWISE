        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=IBM+Plex+Sans:wght@300;400;500;600;700;900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #111111;\n    color: #FFFFFF;\n    font-family: 'IBM Plex Sans', sans-serif;\n    overflow: hidden; /* No scroll as per requirement */\n    height: 100vh;\n    width: 100vw;\n  }\n\n  .font-mono {\n    font-family: 'Inconsolata', monospace;\n  }\n\n  .hairline {\n    border-color: rgba(255, 255, 255, 0.15);\n  }\n\n  .acid-text {\n    color: #A3E635;\n  }\n\n  .acid-bg {\n    background-color: #A3E635;\n  }\n\n  .acid-border {\n    border-color: #A3E635;\n  }\n\n  .scrollbar-hide::-webkit-scrollbar {\n    display: none;\n  }\n\n  .cursor-blink {\n    display: inline-block;\n    width: 0.6em;\n    height: 1.1em;\n    background-color: #A3E635;\n    vertical-align: middle;\n    margin-left: 4px;\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  /* Scramble effect target */\n  .scramble-char {\n    display: inline-block;\n    min-width: 0.5em;\n  }\n\n  /* Isometric container */\n  .isometric-view {\n    perspective: 1000px;\n  }\n  .isometric-element {\n    transform: rotateX(45deg) rotateZ(-45deg);\n  }\n</style>\n<div class=\"flex h-screen w-full overflow-hidden bg-[#111111] selection:bg-[#A3E635] selection:text-[#111111]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- LEFT COLUMN (15%) -->\n    <aside class=\"w-[15%] border-r border-white/15 flex flex-col justify-between py-12 items-center relative z-20\" data-kid=\"1-1\" data-name=\"left sidebar navigation\">\n        <!-- Logo: GRO (W) ISE vertically stacked -->\n        <div class=\"font-mono text-xl font-black tracking-tighter flex flex-col items-center gap-0.5 leading-none opacity-80\" data-kid=\"1-1-1\" data-name=\"logo container\" id=\"logo\">\n            <span data-kid=\"1-1-1-1\" data-name=\"letter G\">\n                G\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"letter R\">\n                R\n            </span>\n            <span data-kid=\"1-1-1-3\" data-name=\"letter O\">\n                O\n            </span>\n            <div class=\"acid-text my-2 relative\" data-kid=\"1-1-1-4\" data-name=\"logo W bracket container\">\n                <span class=\"relative z-10\" data-kid=\"1-1-1-4-1\" data-name=\"bracketed text\">\n                    (W)\n                </span>\n                <div class=\"absolute -inset-1 acid-bg/10 blur-sm rounded-full\" data-kid=\"1-1-1-4-2\" data-name=\"logo glow effect\">\n                </div>\n            </div>\n            <span data-kid=\"1-1-1-5\" data-name=\"letter I\">\n                I\n            </span>\n            <span data-kid=\"1-1-1-6\" data-name=\"letter S\">\n                S\n            </span>\n            <span data-kid=\"1-1-1-7\" data-name=\"letter E\">\n                E\n            </span>\n        </div>\n        <!-- Navigation: Rotated -90 degrees -->\n        <nav class=\"flex flex-col gap-36 items-center flex-1 justify-center relative\" data-kid=\"1-1-2\" data-name=\"vertical navigation links\">\n            <a class=\"rotate-[-90deg] whitespace-nowrap text-[10px] font-mono uppercase tracking-[0.4em] text-white/40 hover:text-[#A3E635] nav-link transition-colors duration-200\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#\">\n                Dashboard\n            </a>\n            <a class=\"rotate-[-90deg] whitespace-nowrap text-[10px] font-mono uppercase tracking-[0.4em] text-white/40 hover:text-[#A3E635] nav-link transition-colors duration-200\" data-kid=\"1-1-2-2\" data-name=\"infra nodes navigation link\" href=\"#\">\n                Infra_Nodes\n            </a>\n            <a class=\"rotate-[-90deg] whitespace-nowrap text-[10px] font-mono uppercase tracking-[0.4em] text-white/40 hover:text-[#A3E635] nav-link transition-colors duration-200\" data-kid=\"1-1-2-3\" data-name=\"security api navigation link\" href=\"#\">\n                Security_API\n            </a>\n        </nav>\n        <!-- Status indicator -->\n        <div class=\"flex items-center gap-2 font-mono text-[9px] acid-text tracking-widest uppercase\" data-kid=\"1-1-3\" data-name=\"system status indicator\">\n            <span class=\"w-1.5 h-1.5 rounded-full acid-bg animate-pulse\" data-kid=\"1-1-3-1\" data-name=\"pulsing status light\">\n            </span>\n            [SYS_OK]\n        </div>\n    </aside>\n    <!-- CENTER COLUMN (60%) -->\n    <main class=\"w-[60%] border-r border-white/15 flex flex-col z-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Top Half: Massive Headline with Scramble Effect -->\n        <section class=\"h-1/2 p-16 flex items-center justify-center border-b border-white/15 relative overflow-hidden bg-black/5\" data-kid=\"1-2-1\" data-name=\"hero headline section\">\n            <div class=\"absolute inset-0 pointer-events-none opacity-5\" data-kid=\"1-2-1-1\" data-name=\"radial grid background\" style=\"background-image: radial-gradient(#A3E635 1px, transparent 1px); background-size: 30px 30px;\">\n            </div>\n            <h1 class=\"text-[7.5vw] font-black uppercase leading-[0.82] tracking-tighter text-center cursor-default\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"scramble headline text\" data-reason=\"text scrambled and replaced by JS script on hover\" id=\"headline\">\n                Scale\n                <br data-kid=\"1-2-1-2-1\" data-name=\"line break\"/>\n                Without\n                <br data-kid=\"1-2-1-2-2\" data-name=\"line break\"/>\n                Breaking.\n            </h1>\n            <!-- Tiny Meta -->\n            <div class=\"absolute top-6 left-8 text-white/10 font-mono text-[9px] uppercase tracking-[0.2em]\" data-kid=\"1-2-1-3\" data-name=\"meta info text\">\n                Interface // Terminal_Alpha_4.0\n            </div>\n        </section>\n        <!-- Bottom Half: Expanded Terminal Log -->\n        <section class=\"h-1/2 p-12 font-mono text-xs overflow-hidden flex flex-col bg-black/20 relative\" data-kid=\"1-2-2\" data-name=\"terminal log section\">\n            <!-- Scanline effect overlay -->\n            <div class=\"absolute inset-0 pointer-events-none opacity-[0.03] z-50 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]\" data-kid=\"1-2-2-1\" data-name=\"scanline effect overlay\">\n            </div>\n            <div class=\"flex items-center justify-between mb-8 text-white/20 uppercase tracking-[0.3em] border-b border-white/5 pb-4\" data-kid=\"1-2-2-2\" data-name=\"terminal header bar\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-1\" data-name=\"terminal icon container\">\n                    <i class=\"ti ti-terminal-2 acid-text text-lg\" data-kid=\"1-2-2-2-1-1\" data-name=\"terminal icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-1-2\" data-name=\"terminal title text\">\n                        Execution_Log_Main\n                    </span>\n                </div>\n                <div class=\"flex gap-4 items-center\" data-kid=\"1-2-2-2-2\" data-name=\"terminal info group\">\n                    <span class=\"text-[9px]\" data-kid=\"1-2-2-2-2-1\" data-name=\"terminal session id text\">\n                        ID: 0x2294A\n                    </span>\n                    <span class=\"text-[9px]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2\" data-name=\"system clock display\" data-reason=\"text replaced every second by time script\" id=\"current-time\">\n                        UTC 00:00:00\n                    </span>\n                </div>\n            </div>\n            <div class=\"space-y-4 overflow-y-auto pr-4 scrollbar-hide flex-1\" data-dynamic=\"true\" data-kid=\"1-2-2-3\" data-name=\"terminal scrollable content area\" data-reason=\"content dynamically injected by log script\" id=\"terminal-content\">\n                <!-- JS will inject lines here -->\n            </div>\n            <!-- Input line -->\n            <div class=\"mt-4 pt-4 border-t border-white/5 flex items-center gap-3 font-mono text-[11px]\" data-kid=\"1-2-2-4\" data-name=\"input line area\">\n                <span class=\"acid-text opacity-70\" data-kid=\"1-2-2-4-1\" data-name=\"input prompt text\">\n                    root@gro-wise:~$\n                </span>\n                <span class=\"text-white/80\" data-kid=\"1-2-2-4-2\" data-name=\"awaiting status text\">\n                    awaiting_command_entry...\n                </span>\n                <span class=\"cursor-blink\" data-kid=\"1-2-2-4-3\" data-name=\"blinking cursor\">\n                </span>\n            </div>\n        </section>\n    </main>\n    <!-- RIGHT COLUMN (25%) -->\n    <aside class=\"w-[25%] flex flex-col z-0\" data-kid=\"1-3\" data-name=\"right sidebar panel\">\n        <!-- Top Pane: Syntax Highlighted DB Snippet -->\n        <section class=\"h-1/2 p-8 border-b border-white/15 flex flex-col bg-black/30\" data-kid=\"1-3-1\" data-name=\"syntax highlighted code panel\">\n            <div class=\"mb-6 flex justify-between items-start\" data-kid=\"1-3-1-1\" data-name=\"code header container\">\n                <div class=\"space-y-1\" data-kid=\"1-3-1-1-1\" data-name=\"code file info container\">\n                    <div class=\"text-white/30 text-[9px] uppercase font-mono tracking-widest\" data-kid=\"1-3-1-1-1-1\" data-name=\"filename text\">\n                        fragment://db_link.ts\n                    </div>\n                    <div class=\"text-[10px] font-mono acid-text/50\" data-kid=\"1-3-1-1-1-2\" data-name=\"read-only badge text\">\n                        READ_ONLY_MODE\n                    </div>\n                </div>\n                <i class=\"ti ti-cpu text-2xl acid-text opacity-80\" data-kid=\"1-3-1-1-2\" data-name=\"cpu icon\">\n                </i>\n            </div>\n            <div class=\"relative group flex-1\" data-kid=\"1-3-1-2\" data-name=\"code snippet container\" id=\"code-snippet-container\">\n                <pre class=\"font-mono text-[10px] leading-relaxed text-white/50 bg-[#151515] p-5 border border-white/5 rounded-xs overflow-hidden relative\" data-kid=\"1-3-1-2-1\" data-name=\"code pre block\">\n<span class=\"acid-text\" data-kid=\"1-3-1-2-1-1\" data-name=\"import keyword\">import</span> { Pool } <span class=\"acid-text\" data-kid=\"1-3-1-2-1-2\" data-name=\"from keyword\">from</span> <span class=\"text-white/80\" data-kid=\"1-3-1-2-1-3\" data-name=\"module path string\">'pg'</span>;\n\n<span class=\"text-white/30\" data-kid=\"1-3-1-2-1-4\" data-name=\"comment text\">// init elastic hook</span>\n<span class=\"acid-text\" data-kid=\"1-3-1-2-1-5\" data-name=\"const keyword\">const</span> db = <span class=\"acid-text\" data-kid=\"1-3-1-2-1-6\" data-name=\"new keyword\">new</span> Pool({\n  host: <span class=\"text-white/80\" data-kid=\"1-3-1-2-1-7\" data-name=\"db host string\">'shrd-v2.net'</span>,\n  db: <span class=\"text-white/80\" data-kid=\"1-3-1-2-1-8\" data-name=\"db name string\">'gw_prod_01'</span>,\n  ssl: <span class=\"acid-text\" data-kid=\"1-3-1-2-1-9\" data-name=\"ssl boolean\">true</span>\n});\n\n<span class=\"acid-text\" data-kid=\"1-3-1-2-1-10\" data-name=\"function keyword\">export async function</span> <span class=\"text-white\" data-kid=\"1-3-1-2-1-11\" data-name=\"sync function name\">sync</span>() {\n  <span class=\"acid-text\" data-kid=\"1-3-1-2-1-12\" data-name=\"const keyword\">const</span> res = <span class=\"acid-text\" data-kid=\"1-3-1-2-1-13\" data-name=\"await keyword\">await</span> db.connect();\n  <span class=\"acid-text\" data-kid=\"1-3-1-2-1-14\" data-name=\"return keyword\">return</span> res.pipe(scalability);\n}\n        </pre>\n                <!-- Decorative frame: aligned tightly -->\n                <div class=\"absolute top-0 left-0 w-2 h-2 border-t border-l border-[#A3E635] z-10 pointer-events-none\" data-kid=\"1-3-1-2-2\" data-name=\"top-left frame corner\">\n                </div>\n                <div class=\"absolute bottom-0 right-0 w-2 h-2 border-b border-r border-[#A3E635] z-10 pointer-events-none\" data-kid=\"1-3-1-2-3\" data-name=\"bottom-right frame corner\">\n                </div>\n            </div>\n        </section>\n        <!-- Bottom Pane: Isometric Server Wireframe -->\n        <section class=\"h-1/2 p-8 flex flex-col relative overflow-hidden group bg-black/10\" data-kid=\"1-3-2\" data-name=\"isometric server section\">\n            <div class=\"absolute top-6 right-6 text-white/10 text-[9px] font-mono text-right z-10\" data-kid=\"1-3-2-1\" data-name=\"architecture scan meta text\">\n                [ARCH_SCAN_009]\n                <br data-kid=\"1-3-2-1-1\" data-name=\"line break\"/>\n                NODE_DENSITY: HIGH\n            </div>\n            <!-- Isometric Visualization -->\n            <div class=\"flex-1 flex flex-col items-center justify-center relative\" data-kid=\"1-3-2-2\" data-name=\"isometric visualization container\">\n                <!-- Technical Crosshair -->\n                <div class=\"absolute inset-0 opacity-10 pointer-events-none\" data-kid=\"1-3-2-2-1\" data-name=\"technical crosshair overlay\">\n                    <div class=\"absolute top-1/2 left-0 w-full h-[1px] bg-white\" data-kid=\"1-3-2-2-1-1\" data-name=\"horizontal line\">\n                    </div>\n                    <div class=\"absolute top-0 left-1/2 w-[1px] h-full bg-white\" data-kid=\"1-3-2-2-1-2\" data-name=\"vertical line\">\n                    </div>\n                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 border border-white rounded-full\" data-kid=\"1-3-2-2-1-3\" data-name=\"circular crosshair\">\n                    </div>\n                </div>\n                <div class=\"relative isometric-view transform-gpu transition-transform duration-1000 group-hover:scale-110\" data-kid=\"1-3-2-2-2\" data-name=\"isometric element wrapper\">\n                    <!-- Multi-layered isometric rack using icon -->\n                    <div class=\"isometric-element relative w-44 h-44\" data-kid=\"1-3-2-2-2-1\" data-name=\"isometric object container\">\n                        <!-- Wireframe Layers: Cleaner filtering -->\n                        <img class=\"absolute inset-0 w-full h-full opacity-20 filter\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"server rack graphic\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/server-rack.svg\" style=\"filter: brightness(0) invert(0.6) sepia(1) saturate(5) hue-rotate(45deg);\"/>\n                        <div class=\"absolute inset-0 border border-[#A3E635]/20 rounded-sm translate-z-10\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"rack border layer 1\">\n                        </div>\n                        <div class=\"absolute inset-0 border border-[#A3E635]/10 rounded-sm translate-z-20\" data-kid=\"1-3-2-2-2-1-3\" data-name=\"rack border layer 2\">\n                        </div>\n                        <!-- Scanning Line -->\n                        <div class=\"absolute top-0 left-0 w-full h-[1px] acid-bg shadow-[0_0_20px_#A3E635] animate-[scan_3s_ease-in-out_infinite]\" data-kid=\"1-3-2-2-2-1-4\" data-name=\"scanning line element\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Detail tags -->\n            <div class=\"mt-auto flex justify-between items-center text-[9px] font-mono text-white/30 uppercase tracking-widest\" data-kid=\"1-3-2-3\" data-name=\"detail tags footer\">\n                <span data-kid=\"1-3-2-3-1\" data-name=\"model tag text\">\n                    V_MODEL_09\n                </span>\n                <div class=\"flex gap-2\" data-kid=\"1-3-2-3-2\" data-name=\"mesh status container\">\n                    <i class=\"ti ti-frame text-xs\" data-kid=\"1-3-2-3-2-1\" data-name=\"frame icon\">\n                    </i>\n                    <span data-kid=\"1-3-2-3-2-2\" data-name=\"status label text\">\n                        MESH_ACTIVE\n                    </span>\n                </div>\n            </div>\n        </section>\n    </aside>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script type=\"module\">\n    // --- INITIAL ANIMATIONS ---\n  function initPage() {\n    gsap.from(\"#logo span\", {\n      opacity: 0,\n      y: -20,\n      duration: 0.5,\n      stagger: 0.05,\n      ease: \"power2.out\"\n    });\n\n    gsap.from(\".nav-link\", {\n      opacity: 0,\n      x: -30,\n      duration: 0.8,\n      stagger: 0.1,\n      ease: \"power2.out\",\n      delay: 0.3\n    });\n\n    gsap.from(\"#headline\", {\n      opacity: 0,\n      scale: 0.9,\n      duration: 1.5,\n      ease: \"expo.out\"\n    });\n  }\n\n  // --- SCRAMBLE EFFECT ---\n  const headline = document.getElementById('headline');\n  const originalText = headline.innerHTML;\n  const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+\";\n\n  function scrambleText(element, finalHtml) {\n    const textNodes = [];\n    // Extract text without losing <br>\n    const temp = document.createElement('div');\n    temp.innerHTML = finalHtml;\n    const items = Array.from(temp.childNodes);\n\n    let progress = 0;\n    const duration = 20; // frames\n    \n    const interval = setInterval(() => {\n      element.innerHTML = items.map(node => {\n        if (node.nodeType === 3) { // Text node\n          return node.textContent.split('').map((char, i) => {\n            if (char === ' ') return ' ';\n            if (Math.random() > progress / duration) {\n              return chars[Math.floor(Math.random() * chars.length)];\n            }\n            return char;\n          }).join('');\n        }\n        return node.outerHTML; // <br>\n      }).join('');\n\n      progress++;\n      if (progress > duration) {\n        clearInterval(interval);\n        element.innerHTML = finalHtml;\n      }\n    }, 40);\n  }\n\n  headline.addEventListener('mouseenter', () => scrambleText(headline, originalText));\n\n  // --- TERMINAL LOGIC ---\n  const terminalContent = document.getElementById('terminal-content');\n  const logs = [\n    { time: \"00.01\", text: \"Initializing kernel modules [0x8823]...\", color: \"white/70\" },\n    { time: \"00.04\", text: \"Fetching infrastructure manifests from srv-edge-01...\", color: \"white/70\" },\n    { time: \"00.08\", text: \"Node balance status: CRITICAL // LOAD_AVG > 4.2\", color: \"acid-text\" },\n    { time: \"00.12\", text: \"Launching recovery protocols (RSA_4096)...\", color: \"white/70\" },\n    { time: \"00.15\", text: \"Re-routing traffic: 10.0.0.1 -> 172.16.2.4\", color: \"white/70\" },\n    { time: \"00.20\", type: \"progress\", label: \"Allocating_Memory_Cluster_A\", progress: 82 },\n    { time: \"00.25\", text: \"Connection established: 200 OK via Cluster_Delta\", color: \"acid-text\" },\n    { time: \"00.30\", type: \"progress\", label: \"Syncing_Database_Replica\", progress: 45 },\n    { time: \"00.35\", text: \"Awaiting final hand-shake: 0xFD22...\", color: \"white/40\" },\n    { time: \"00.38\", text: \"Verifying checksums: [OK] [OK] [OK]\", color: \"white/60\" },\n    { time: \"00.40\", text: \">> SECURITY_LEVEL_HIGH // PROTOCOL_READY\", color: \"acid-text font-black\" }\n  ];\n\n  async function addLogLine(log) {\n    const line = document.createElement('div');\n    line.className = 'flex gap-4';\n    \n    const timeSpan = document.createElement('span');\n    timeSpan.className = 'text-white/20';\n    timeSpan.textContent = `[${log.time}]`;\n    line.appendChild(timeSpan);\n\n    if (log.type === 'progress') {\n      const container = document.createElement('div');\n      container.className = 'flex-1 font-mono';\n      \n      const barsCount = 20;\n      const filledCount = Math.floor((log.progress / 100) * barsCount);\n      const barString = '[' + '|'.repeat(filledCount) + ' '.repeat(barsCount - filledCount) + ']';\n      \n      container.innerHTML = `\n        <div class=\"flex justify-between items-center text-[10px] mb-1\">\n          <span class=\"text-white/60\">${log.label}</span>\n          <span class=\"acid-text\">${log.progress}%</span>\n        </div>\n        <div class=\"text-white/40 leading-none\">${barString}</div>\n      `;\n      line.appendChild(container);\n    } else {\n      const textSpan = document.createElement('span');\n      textSpan.className = `text-${log.color}`;\n      textSpan.textContent = log.text;\n      line.appendChild(textSpan);\n    }\n\n    terminalContent.appendChild(line);\n    terminalContent.scrollTop = terminalContent.scrollHeight;\n  }\n\n  async function runLogs() {\n    for (const log of logs) {\n      await new Promise(r => setTimeout(r, 600 + Math.random() * 800));\n      addLogLine(log);\n    }\n  }\n\n  // --- HELPERS ---\n  function updateTime() {\n    const now = new Date();\n    document.getElementById('current-time').textContent = `UTC ${now.toISOString().slice(11, 19)}`;\n  }\n\n  // START\n  initPage();\n  runLogs();\n  setInterval(updateTime, 1000);\n  updateTime();\n</script>\n<style>\n    @keyframes scan {\n    0% { top: 0%; opacity: 0; }\n    10% { opacity: 1; }\n    90% { opacity: 1; }\n    100% { top: 100%; opacity: 0; }\n  }\n\n  .translate-z-10 { transform: translateZ(-10px); }\n  .translate-z-20 { transform: translateZ(-20px); }\n</style>\n",
      "comments": [],
      "created": "2026-07-20T19:18:59.769321+00:00",
      "modified": "2026-07-20T19:18:59.769321+00:00",
      "id": "var_e10aca9eb730"
    },
    "var_8bafa612e8d9": {
      "type": "variant",
      "label": "Editorial Terminal - Workflow Visualization",
      "parentId": "var_bc574f0d21eb",
      "themeId": null,
      "rect": {
        "x": 4301,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg: #111111;\n    --acid: #A3E635;\n    --border: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--bg);\n    color: #FFFFFF;\n    font-family: 'IBM Plex Sans', sans-serif;\n    overflow: hidden;\n  }\n\n  .font-mono { font-family: 'Inconsolata', monospace; }\n  \n  .terminal-border {\n    border: 1px solid var(--border);\n  }\n\n  .acid-text { color: var(--acid); }\n  .acid-bg { background-color: var(--acid); }\n  .acid-border { border-color: var(--acid); }\n\n  .cursor-blink {\n    display: inline-block;\n    width: 0.6em;\n    height: 1.2em;\n    background-color: var(--acid);\n    vertical-align: middle;\n    margin-left: 4px;\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  .viz-panel {\n    background: radial-gradient(circle at center, rgba(163, 230, 53, 0.03) 0%, transparent 70%);\n  }\n\n  /* Grid overlay for viz area */\n  .viz-grid {\n    background-image: radial-gradient(var(--border) 1px, transparent 1px);\n    background-size: 32px 32px;\n  }\n</style>\n<div class=\"h-screen w-full flex flex-col relative\" data-kid=\"1\" data-name=\"app container\" id=\"app-container\">\n    <!-- Top Nav -->\n    <nav class=\"h-20 flex items-center justify-between px-12 border-b border-white/10 z-50\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-1\" data-name=\"brand logo container\">\n            <span class=\"font-mono text-2xl font-black tracking-tighter uppercase\" data-kid=\"1-1-1-1\" data-name=\"brand name\">\n                GRO\n                <span class=\"acid-text\" data-kid=\"1-1-1-1-1\" data-name=\"brand name accent\">\n                    (W)\n                </span>\n                ISE\n            </span>\n        </div>\n        <div class=\"flex items-center gap-12 font-mono text-xs uppercase tracking-widest font-bold\" data-kid=\"1-1-2\" data-name=\"navigation menu links\">\n            <a class=\"text-white/50 hover:text-white transition-colors\" data-kid=\"1-1-2-1\" data-name=\"dashboard link\" href=\"#\">\n                Dashboard\n            </a>\n            <a class=\"text-white/50 hover:text-white transition-colors\" data-kid=\"1-1-2-2\" data-name=\"pricing link\" href=\"#\">\n                Pricing\n            </a>\n            <a class=\"text-white/50 hover:text-white transition-colors\" data-kid=\"1-1-2-3\" data-name=\"docs link\" href=\"#\">\n                Docs\n            </a>\n            <button class=\"px-6 py-2 border border-white/20 hover:bg-[#A3E635] hover:text-[#111111] transition-all uppercase tracking-widest\" data-kid=\"1-1-2-4\" data-name=\"login button\">\n                Login\n            </button>\n        </div>\n    </nav>\n    <!-- Main Content: Split Pane -->\n    <main class=\"flex-1 flex overflow-hidden\" data-kid=\"1-2\" data-name=\"main content split pane\">\n        <!-- Left: Terminal Logs -->\n        <section class=\"w-[450px] border-r border-white/10 flex flex-col p-10 font-mono text-xs leading-relaxed overflow-y-auto bg-[#0d0d0d]\" data-kid=\"1-2-1\" data-name=\"left terminal logs section\">\n            <div class=\"mb-8 text-white/30 uppercase tracking-[0.2em] flex items-center justify-between\" data-kid=\"1-2-1-1\" data-name=\"execution log header\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-1\" data-name=\"execution log title container\">\n                    <i class=\"ti ti-command\" data-kid=\"1-2-1-1-1-1\" data-name=\"execution log icon\">\n                    </i>\n                    <span data-kid=\"1-2-1-1-1-2\" data-name=\"execution log title text\">\n                        Execution Log\n                    </span>\n                </div>\n                <span class=\"text-[10px]\" data-kid=\"1-2-1-1-2\" data-name=\"session identifier text\">\n                    Session: #X-299\n                </span>\n            </div>\n            <div class=\"space-y-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"dynamic log items container\" data-reason=\"log entries and typewriter text injected by script\" id=\"log-container\">\n                <!-- Log items will be injected here -->\n            </div>\n        </section>\n        <!-- Right: Visualization Area -->\n        <section class=\"flex-1 relative viz-panel flex flex-col items-center justify-center p-12 overflow-hidden\" data-kid=\"1-2-2\" data-name=\"right visualization area\">\n            <!-- Background Grid -->\n            <div class=\"absolute inset-0 viz-grid opacity-20 pointer-events-none\" data-kid=\"1-2-2-1\" data-name=\"background grid pattern\">\n            </div>\n            <!-- Visualization Stage -->\n            <div class=\"w-full h-full flex items-center justify-center relative z-10\" data-dynamic=\"true\" data-kid=\"1-2-2-2\" data-name=\"visualization stage container\" data-reason=\"visual components injected and animated by script\" id=\"viz-stage\">\n                <!-- Dynamic content injected here -->\n            </div>\n            <!-- Viewport Metadata (Bottom Corner) -->\n            <div class=\"absolute bottom-8 right-8 font-mono text-[10px] text-white/20 uppercase tracking-widest\" data-kid=\"1-2-2-3\" data-name=\"viewport metadata\">\n                v1.0.4 // Carbon-Acid Workflow Visualizer\n            </div>\n        </section>\n    </main>\n</div>\n<script type=\"module\">\n    import { animate, scroll, stagger, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  const workflow = [\n    {\n      id: \"login\",\n      log: \"> Establishing secure link... login_success\",\n      viz: `\n        <div class=\"flex flex-col items-center gap-6 p-12 border border-[#A3E635]/20 bg-[#111111] w-96 relative\">\n          <div class=\"absolute -top-3 left-6 px-2 bg-[#111111] text-[10px] font-mono acid-text uppercase\">Identity Verified</div>\n          <div class=\"w-16 h-16 rounded-full border border-[#A3E635] flex items-center justify-center mb-2\">\n            <i class=\"ti ti-user-check text-3xl acid-text\"></i>\n          </div>\n          <div class=\"text-center space-y-2\">\n            <h3 class=\"font-mono text-xl font-bold uppercase tracking-tight\">Access Granted</h3>\n            <p class=\"text-xs text-white/40 font-mono\">Token: xf_771...v2</p>\n          </div>\n        </div>\n      `\n    },\n    {\n      id: \"connect\",\n      log: \"> Connected to GitHub API... listing repositories\",\n      viz: `\n        <div class=\"w-[450px] border border-white/10 bg-[#111111] p-8 space-y-6\">\n          <div class=\"flex items-center justify-between border-b border-white/5 pb-4\">\n            <span class=\"font-mono text-xs text-white/40 uppercase\">GitHub / Repositories</span>\n            <i class=\"ti ti-brand-github text-xl\"></i>\n          </div>\n          <div class=\"space-y-3\">\n            <div class=\"p-3 border border-[#A3E635] bg-[#A3E635]/5 flex items-center justify-between\">\n              <span class=\"font-mono text-sm\">lovable-clone-v3</span>\n              <i class=\"ti ti-circle-check-filled acid-text\"></i>\n            </div>\n            <div class=\"p-3 border border-white/5 opacity-50 flex items-center justify-between\">\n              <span class=\"font-mono text-sm\">enterprise-saas-core</span>\n              <i class=\"ti ti-circle\"></i>\n            </div>\n            <div class=\"p-3 border border-white/5 opacity-50 flex items-center justify-between\">\n              <span class=\"font-mono text-sm\">infrastructure-as-code</span>\n              <i class=\"ti ti-circle\"></i>\n            </div>\n          </div>\n        </div>\n      `\n    },\n    {\n      id: \"detect\",\n      log: \"> Framework detection: Next.js + React identified\",\n      viz: `\n        <div class=\"flex items-center gap-12\">\n          <div class=\"flex flex-col items-center gap-4\">\n            <div class=\"w-32 h-32 terminal-border flex items-center justify-center relative overflow-hidden group\">\n              <div class=\"absolute inset-0 bg-[#A3E635]/10 translate-y-full group-hover:translate-y-0 transition-transform\"></div>\n              <i class=\"ti ti-brand-nextjs text-6xl relative z-10\"></i>\n            </div>\n            <span class=\"font-mono text-xs uppercase tracking-widest acid-text\">Next.js 14</span>\n          </div>\n          <div class=\"w-12 h-px bg-white/20\"></div>\n          <div class=\"flex flex-col items-center gap-4\">\n            <div class=\"w-32 h-32 terminal-border flex items-center justify-center relative overflow-hidden group\">\n              <i class=\"ti ti-brand-react text-6xl relative z-10 acid-text\"></i>\n            </div>\n            <span class=\"font-mono text-xs uppercase tracking-widest acid-text\">React 18</span>\n          </div>\n        </div>\n      `\n    },\n    {\n      id: \"mapping\",\n      log: \"> Mapping codebase architecture... generating graph\",\n      viz: `\n        <div class=\"relative w-[500px] h-[300px]\">\n          <!-- Simple node-link diagram visual -->\n          <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 border border-[#A3E635] flex items-center justify-center bg-[#111111] z-20\">\n             <span class=\"font-mono text-xs font-bold uppercase\">Root</span>\n          </div>\n          <div class=\"absolute top-0 left-0 w-20 h-20 border border-white/20 flex items-center justify-center bg-[#111111] animate-pulse\">\n             <span class=\"font-mono text-[10px]\">API</span>\n          </div>\n          <div class=\"absolute bottom-0 left-10 w-20 h-20 border border-white/20 flex items-center justify-center bg-[#111111]\">\n             <span class=\"font-mono text-[10px]\">AUTH</span>\n          </div>\n          <div class=\"absolute top-10 right-0 w-20 h-20 border border-white/20 flex items-center justify-center bg-[#111111]\">\n             <span class=\"font-mono text-[10px]\">DB</span>\n          </div>\n          <!-- SVG Lines -->\n          <svg class=\"absolute inset-0 w-full h-full -z-10\">\n            <line x1=\"100\" y1=\"100\" x2=\"250\" y2=\"150\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"1\" />\n            <line x1=\"110\" y1=\"200\" x2=\"250\" y2=\"150\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"1\" />\n            <line x1=\"400\" y1=\"100\" x2=\"250\" y2=\"150\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"1\" />\n          </svg>\n        </div>\n      `\n    },\n    {\n      id: \"analysis\",\n      log: \"> Dispatching 5 intelligent agents... processing archetypes\",\n      viz: `\n        <div class=\"grid grid-cols-3 gap-8\">\n          ${[1, 2, 3, 4, 5].map(i => `\n            <div class=\"p-4 border border-white/10 bg-white/[0.02] flex flex-col items-center gap-3\">\n              <div class=\"w-8 h-8 rounded-full bg-[#A3E635]/10 flex items-center justify-center\">\n                <i class=\"ti ti-robot text-sm acid-text\"></i>\n              </div>\n              <div class=\"w-16 h-1 bg-white/5 relative overflow-hidden\">\n                <div class=\"absolute inset-0 bg-[#A3E635] animate-[loading_1.5s_infinite_ease-in-out]\"></div>\n              </div>\n              <span class=\"font-mono text-[9px] uppercase tracking-tighter opacity-50\">Agent_${i}</span>\n            </div>\n          `).join('')}\n        </div>\n        <style>\n          @keyframes loading {\n            0% { transform: translateX(-100%); }\n            100% { transform: translateX(100%); }\n          }\n        </style>\n      `\n    },\n    {\n      id: \"report\",\n      log: \"> Compilation complete... report artifacts ready\",\n      viz: `\n        <div class=\"w-[400px] border border-[#A3E635] bg-[#111111] p-10 flex flex-col items-center shadow-[0_0_40px_rgba(163,230,53,0.1)]\">\n          <span class=\"font-mono text-xs uppercase tracking-widest text-white/40 mb-2\">Final Scalability Score</span>\n          <h2 class=\"text-8xl font-mono font-black acid-text\">98<span class=\"text-3xl opacity-50\">%</span></h2>\n          <div class=\"mt-8 grid grid-cols-2 gap-4 w-full\">\n            <div class=\"p-3 border border-white/10 text-center\">\n              <div class=\"text-[10px] text-white/30 uppercase mb-1\">Latency</div>\n              <div class=\"font-mono text-sm\">24ms</div>\n            </div>\n            <div class=\"p-3 border border-white/10 text-center\">\n              <div class=\"text-[10px] text-white/30 uppercase mb-1\">Risk Factor</div>\n              <div class=\"font-mono text-sm acid-text\">Low</div>\n            </div>\n          </div>\n        </div>\n      `\n    },\n    {\n      id: \"chatbot\",\n      log: \"> Interface online... awaiting operator queries\",\n      viz: `\n        <div class=\"w-[480px] h-[400px] border border-white/10 bg-[#111111] flex flex-col\">\n          <div class=\"p-4 border-b border-white/5 flex items-center justify-between\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-2 h-2 rounded-full bg-[#A3E635]\"></div>\n              <span class=\"font-mono text-xs uppercase font-bold\">Gro(W)ise Assistant</span>\n            </div>\n            <div class=\"flex gap-2\">\n               <div class=\"w-2 h-2 bg-white/10\"></div>\n               <div class=\"w-2 h-2 bg-white/10\"></div>\n            </div>\n          </div>\n          <div class=\"flex-1 p-6 space-y-4 overflow-y-auto\">\n            <div class=\"p-3 bg-white/5 max-w-[80%] font-mono text-[11px] leading-relaxed\">\n              Analysis complete. I can now assist with:\n              <br/>• Opening GitHub issues for bottlenecks\n              <br/>• Generating a fix-action plan\n              <br/>• General architectural queries\n            </div>\n          </div>\n          <div class=\"p-4 border-t border-white/10 space-y-3\">\n            <div class=\"grid grid-cols-3 gap-2\">\n              <button class=\"px-2 py-1.5 border border-[#A3E635]/30 text-[9px] uppercase font-bold hover:bg-[#A3E635] hover:text-[#111111] transition-all\">Open Issue</button>\n              <button class=\"px-2 py-1.5 border border-[#A3E635]/30 text-[9px] uppercase font-bold hover:bg-[#A3E635] hover:text-[#111111] transition-all\">Gen Plan</button>\n              <button class=\"px-2 py-1.5 border border-[#A3E635]/30 text-[9px] uppercase font-bold hover:bg-[#A3E635] hover:text-[#111111] transition-all\">Query</button>\n            </div>\n            <div class=\"h-10 border border-white/10 flex items-center px-3 justify-between\">\n              <span class=\"font-mono text-[10px] text-white/30\">Ask me anything...</span>\n              <i class=\"ti ti-send text-white/20\"></i>\n            </div>\n          </div>\n        </div>\n      `\n    }\n  ];\n\n  async function startWorkflow() {\n    const logContainer = document.getElementById('log-container');\n    const vizStage = document.getElementById('viz-stage');\n\n    for (let i = 0; i < workflow.length; i++) {\n      const step = workflow[i];\n      \n      // 1. Add Log Line\n      const logLine = document.createElement('div');\n      logLine.className = 'flex flex-col gap-1';\n      logLine.innerHTML = `\n        <div class=\"flex items-start gap-3\">\n          <span class=\"text-[#A3E635] font-bold\">$</span>\n          <span id=\"text-${step.id}\" class=\"text-white/80\"></span>\n        </div>\n      `;\n      logContainer.appendChild(logLine);\n\n      // Typewriter Effect for Log\n      const targetText = step.log;\n      const textSpan = document.getElementById(`text-${step.id}`);\n      for (let char of targetText) {\n        textSpan.textContent += char;\n        await new Promise(r => setTimeout(r, 15));\n      }\n\n      // 2. Update Visualization Area\n      // Fade out old\n      if (vizStage.children.length > 0) {\n        await animate(vizStage, { opacity: 0, scale: 0.95 }, { duration: 0.3 }).finished;\n      }\n      \n      // Inject new\n      vizStage.innerHTML = step.viz;\n      \n      // Fade in new\n      await animate(vizStage, { opacity: 1, scale: 1 }, { duration: 0.5, ease: \"backOut\" }).finished;\n\n      // Pause before next step\n      await new Promise(r => setTimeout(r, 1200));\n\n      // Dim previous logs\n      animate(logLine, { opacity: 0.5 }, { duration: 0.5 });\n    }\n  }\n\n  // Delay start for dramatic entrance\n  setTimeout(startWorkflow, 1000);\n</script>\n",
      "comments": [],
      "created": "2026-07-21T11:12:42.972201+00:00",
      "modified": "2026-07-21T11:13:11.108807+00:00",
      "id": "var_8bafa612e8d9"
    },
    "var_dc75ce68d10e": {
      "type": "variant",
      "label": "Editorial Terminal - Floating Diagnostic UI",
      "parentId": "var_bc574f0d21eb",
      "themeId": null,
      "rect": {
        "x": 5841,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: #111111;\n    color: #FFFFFF;\n    font-family: 'IBM Plex Sans', sans-serif;\n    overflow: hidden;\n  }\n\n  .font-mono { font-family: 'Inconsolata', monospace; }\n\n  /* Background Glows */\n  .glow {\n    position: absolute;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(163, 230, 53, 0.05) 0%, transparent 70%);\n    filter: blur(40px);\n    z-index: 0;\n  }\n\n  .acid-border { border: 1px solid rgba(163, 230, 53, 0.3); }\n  .acid-text { color: #A3E635; }\n  \n  .terminal-window {\n    background: rgba(17, 17, 17, 0.8);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    box-shadow: 0 20px 50px rgba(0,0,0,0.5);\n  }\n\n  /* Diagnostic card styles */\n  .diag-card {\n    background: rgba(255, 255, 255, 0.02);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    backdrop-filter: blur(10px);\n  }\n\n  .cursor-blink {\n    display: inline-block;\n    width: 0.6em;\n    height: 1.2em;\n    background-color: #A3E635;\n    vertical-align: middle;\n    margin-left: 4px;\n    animation: blink 1s step-end infinite;\n  }\n\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n\n  @keyframes orbit {\n    from { transform: rotate(0deg) translateX(100px) rotate(0deg); }\n    to { transform: rotate(360deg) translateX(100px) rotate(-360deg); }\n  }\n\n  .orbit-agent {\n    animation: orbit 4s linear infinite;\n  }\n</style>\n<div class=\"h-screen w-full relative overflow-hidden flex flex-col\" data-kid=\"1\">\n    <!-- Ambient Background -->\n    <div class=\"glow top-[-100px] left-[-100px]\" data-kid=\"1-1\">\n    </div>\n    <div class=\"glow bottom-[-100px] right-[-100px]\" data-kid=\"1-2\">\n    </div>\n    <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none\" data-kid=\"1-3\" style=\"background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');\">\n    </div>\n    <!-- Header -->\n    <header class=\"h-20 flex items-center justify-between px-12 z-50\" data-kid=\"1-4\">\n        <div class=\"font-mono text-xl font-black uppercase tracking-tighter\" data-kid=\"1-4-1\" data-name=\"brand name container\">\n            GRO\n            <span class=\"acid-text\" data-kid=\"1-4-1-1\" data-name=\"brand acronym part\">\n                (W)\n            </span>\n            ISE\n        </div>\n        <div class=\"flex items-center gap-10 font-mono text-[10px] uppercase tracking-widest text-white/40\" data-kid=\"1-4-2\" data-name=\"navigation menu links\">\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-4-2-1\" data-name=\"project atlas link\" href=\"#\">\n                Project_Atlas\n            </a>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"1-4-2-2\" data-name=\"resources link\" href=\"#\">\n                Resources\n            </a>\n            <button class=\"px-5 py-2 border border-white/10 hover:border-[#A3E635] hover:text-[#A3E635] transition-all\" data-kid=\"1-4-2-3\" data-name=\"terminal access button\">\n                Terminal_Access\n            </button>\n        </div>\n    </header>\n    <main class=\"flex-1 relative p-12 flex gap-12 items-start\" data-kid=\"1-5\">\n        <!-- Floating Terminal Window (Left) -->\n        <div class=\"terminal-window w-[400px] flex flex-col z-40 relative\" data-kid=\"1-5-1\" data-name=\"terminal window container\">\n            <div class=\"h-10 border-b border-white/10 flex items-center px-4 justify-between\" data-kid=\"1-5-1-1\" data-name=\"terminal header bar\">\n                <div class=\"flex gap-1.5\" data-kid=\"1-5-1-1-1\" data-name=\"terminal window controls\">\n                    <div class=\"w-2 h-2 rounded-full bg-red-500/50\" data-kid=\"1-5-1-1-1-1\" data-name=\"window control close icon\">\n                    </div>\n                    <div class=\"w-2 h-2 rounded-full bg-yellow-500/50\" data-kid=\"1-5-1-1-1-2\" data-name=\"window control minimize icon\">\n                    </div>\n                    <div class=\"w-2 h-2 rounded-full bg-green-500/50\" data-kid=\"1-5-1-1-1-3\" data-name=\"window control maximize icon\">\n                    </div>\n                </div>\n                <span class=\"font-mono text-[9px] uppercase tracking-widest text-white/20\" data-kid=\"1-5-1-1-2\" data-name=\"diagnostic stream title\">\n                    Diagnostic_Stream_v4\n                </span>\n            </div>\n            <div class=\"p-6 font-mono text-xs leading-relaxed space-y-3 min-h-[300px]\" data-dynamic=\"true\" data-kid=\"1-5-1-2\" data-name=\"log content display\" data-reason=\"log lines and text content appended by sequence script\" id=\"log-content\">\n                <!-- Logs appear here -->\n            </div>\n            <div class=\"h-10 border-t border-white/10 flex items-center px-4\" data-kid=\"1-5-1-3\" data-name=\"terminal status bar\">\n                <span class=\"font-mono text-[9px] text-white/20 uppercase tracking-tighter\" data-kid=\"1-5-1-3-1\" data-name=\"agent heartbeat status label\">\n                    Agent Heartbeat:\n                    <span class=\"acid-text\" data-kid=\"1-5-1-3-1-1\" data-name=\"agent status indicator\">\n                        Stable\n                    </span>\n                </span>\n            </div>\n        </div>\n        <!-- Visualization Space (Right/Center) -->\n        <div class=\"flex-1 h-full relative z-30 flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"1-5-2\" data-name=\"visualization space\" data-reason=\"diagrams and UI snippets replaced by sequence script\" id=\"viz-container\">\n            <!-- Dynamic UI Snippets / Diagrams appear here -->\n        </div>\n    </main>\n</div>\n<script type=\"module\">\n    import { animate, scroll, stagger, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  const steps = [\n    {\n      log: \"> Auth protocol initiated... user_verified\",\n      viz: `\n        <div class=\"diag-card p-10 acid-border flex flex-col items-center gap-6\" id=\"viz-node\">\n          <i class=\"ti ti-shield-lock text-5xl acid-text\"></i>\n          <div class=\"text-center\">\n            <h4 class=\"font-mono font-bold uppercase tracking-widest\">Operator Authenticated</h4>\n            <p class=\"text-[10px] text-white/40 mt-1 uppercase\">Permissions: Global_Admin</p>\n          </div>\n        </div>\n      `\n    },\n    {\n      log: \"> Fetching GitHub metadata... lovable-clone selected\",\n      viz: `\n        <div class=\"flex flex-col gap-4 w-[320px]\" id=\"viz-node\">\n          <div class=\"diag-card p-4 flex items-center gap-4\">\n            <i class=\"ti ti-brand-github text-2xl\"></i>\n            <div class=\"flex-1\">\n               <div class=\"font-mono text-xs font-bold uppercase\">lovable-clone-repo</div>\n               <div class=\"h-1 bg-white/5 mt-1 relative overflow-hidden\">\n                 <div class=\"absolute inset-0 bg-[#A3E635] w-full origin-left\"></div>\n               </div>\n            </div>\n          </div>\n          <div class=\"grid grid-cols-2 gap-4\">\n            <div class=\"diag-card p-3 font-mono text-[9px] uppercase text-white/40\">Status: Fetched</div>\n            <div class=\"diag-card p-3 font-mono text-[9px] uppercase text-white/40\">Commits: 2.4k</div>\n          </div>\n        </div>\n      `\n    },\n    {\n      log: \"> Scanning manifest... Next.js 14 detected\",\n      viz: `\n        <div class=\"flex flex-col items-center gap-8\" id=\"viz-node\">\n           <div class=\"w-40 h-40 rounded-full border border-dashed border-[#A3E635]/30 flex items-center justify-center relative\">\n              <i class=\"ti ti-brand-nextjs text-7xl\"></i>\n              <div class=\"absolute inset-0 animate-spin-slow\">\n                 <div class=\"w-3 h-3 rounded-full bg-[#A3E635] absolute -top-1.5 left-1/2 -translate-x-1/2\"></div>\n              </div>\n           </div>\n           <span class=\"font-mono text-xs font-bold uppercase tracking-[0.3em] acid-text\">Optimized Framework Found</span>\n        </div>\n        <style>\n          @keyframes spin-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n          .animate-spin-slow { animation: spin-slow 8s linear infinite; }\n        </style>\n      `\n    },\n    {\n      log: \"> Mapping dependency graph... resolve_success\",\n      viz: `\n        <div class=\"relative w-[500px] h-[300px]\" id=\"viz-node\">\n           <!-- Stylized Graph -->\n           <svg class=\"absolute inset-0 w-full h-full opacity-30\">\n              <path d=\"M100 150 Q 250 50 400 150\" fill=\"none\" stroke=\"#A3E635\" stroke-width=\"1\" />\n              <path d=\"M100 150 Q 250 250 400 150\" fill=\"none\" stroke=\"#A3E635\" stroke-width=\"1\" />\n           </svg>\n           <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 p-4 diag-card border-[#A3E635] uppercase font-mono text-xs\">Core_Architecture</div>\n           <div class=\"absolute left-0 top-1/2 -translate-y-1/2 p-2 diag-card text-[9px]\">API</div>\n           <div class=\"absolute right-0 top-1/2 -translate-y-1/2 p-2 diag-card text-[9px]\">CLIENT</div>\n        </div>\n      `\n    },\n    {\n      log: \"> Analyzing archetypes... Agent swarm deployed\",\n      viz: `\n        <div class=\"relative w-64 h-64\" id=\"viz-node\">\n           <div class=\"absolute inset-0 flex items-center justify-center\">\n              <i class=\"ti ti-ai text-4xl acid-text\"></i>\n           </div>\n           ${[0, 72, 144, 216, 288].map(deg => `\n             <div class=\"absolute inset-0\" style=\"transform: rotate(${deg}deg)\">\n                <div class=\"w-10 h-10 diag-card rounded-full flex items-center justify-center\" style=\"transform: rotate(-${deg}deg)\">\n                   <i class=\"ti ti-robot text-sm\"></i>\n                </div>\n             </div>\n           `).join('')}\n        </div>\n      `\n    },\n    {\n      log: \"> Report compiled... scalability_factor: 0.94\",\n      viz: `\n        <div class=\"diag-card p-12 flex flex-col items-center gap-4 shadow-[0_0_50px_rgba(163,230,53,0.1)]\" id=\"viz-node\">\n           <span class=\"font-mono text-[10px] uppercase text-white/30\">Readiness Score</span>\n           <div class=\"text-7xl font-mono font-black acid-text\">94<span class=\"text-2xl\">%</span></div>\n           <div class=\"flex gap-2 mt-4\">\n              <div class=\"h-1 w-8 acid-bg\"></div>\n              <div class=\"h-1 w-8 acid-bg\"></div>\n              <div class=\"h-1 w-8 acid-bg\"></div>\n              <div class=\"h-1 w-8 bg-white/10\"></div>\n           </div>\n        </div>\n      `\n    },\n    {\n      log: \"> AI_Assistant online... awaiting query\",\n      viz: `\n        <div class=\"diag-card w-[400px] flex flex-col overflow-hidden\" id=\"viz-node\">\n           <div class=\"p-4 bg-white/5 flex items-center gap-2\">\n              <i class=\"ti ti-message-circle acid-text\"></i>\n              <span class=\"font-mono text-[10px] uppercase font-bold\">Bot_Channel_Active</span>\n           </div>\n           <div class=\"p-6 space-y-4\">\n              <div class=\"p-3 bg-[#111111] border border-white/5 font-mono text-[11px] text-white/60\">\n                I've identified 3 bottlenecks in your database pooling. Would you like to:\n              </div>\n              <div class=\"flex flex-col gap-2\">\n                 <button class=\"w-full py-2 border border-white/10 hover:border-[#A3E635] text-[10px] uppercase font-bold transition-all\">Open GitHub Issues</button>\n                 <button class=\"w-full py-2 border border-white/10 hover:border-[#A3E635] text-[10px] uppercase font-bold transition-all\">Generate Implementation Plan</button>\n                 <button class=\"w-full py-2 border border-[#A3E635] acid-text text-[10px] uppercase font-bold transition-all\">Ask Architecture Query</button>\n              </div>\n           </div>\n        </div>\n      `\n    }\n  ];\n\n  async function runSequence() {\n    const logEl = document.getElementById('log-content');\n    const vizEl = document.getElementById('viz-container');\n\n    for (let i = 0; i < steps.length; i++) {\n      const step = steps[i];\n      \n      // Add Log Line\n      const line = document.createElement('div');\n      line.className = 'flex gap-2';\n      line.innerHTML = `<span class=\"acid-text\">$</span><span class=\"text-white/80\" id=\"t-${i}\"></span>`;\n      logEl.appendChild(line);\n\n      // Typewriter\n      const text = step.log;\n      const tSpan = document.getElementById(`t-${i}`);\n      for (let char of text) {\n        tSpan.textContent += char;\n        await new Promise(r => setTimeout(r, 20));\n      }\n\n      // Update Viz\n      if (vizEl.children.length > 0) {\n        await animate(\"#viz-node\", { opacity: 0, x: 20 }, { duration: 0.3 }).finished;\n      }\n      \n      vizEl.innerHTML = step.viz;\n      \n      await animate(\"#viz-node\", { opacity: [0, 1], x: [-20, 0] }, { duration: 0.5, ease: \"easeOut\" }).finished;\n\n      await new Promise(r => setTimeout(r, 1500));\n      \n      // Dim previous logs\n      animate(line, { opacity: 0.4 }, { duration: 0.5 });\n    }\n  }\n\n  setTimeout(runSequence, 1000);\n</script>\n",
      "comments": [],
      "created": "2026-07-21T11:13:53.691105+00:00",
      "modified": "2026-07-21T11:13:59.165670+00:00",
